{
  "name": "@pulse-music/web-component",
  "version": "3.0.0",
  "description": "Drop-in music player Custom Elements — <pulse-player>, <pulse-fab>, <pulse-track>. Works in any framework or plain HTML.",
  "keywords": [
    "web-components",
    "custom-elements",
    "lit",
    "music-player",
    "audio-player",
    "visualizer",
    "pulse-player"
  ],
  "license": "MIT",
  "author": "YamadaBlog",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YamadaBlog/pulse-player.git",
    "directory": "packages/web-component"
  },
  "homepage": "https://yamadablog.github.io/pulse-player/",
  "bugs": {
    "url": "https://github.com/YamadaBlog/pulse-player/issues"
  },
  "type": "module",
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "customElements": "custom-elements.json",
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "scripts": {
    "build": "tsdown && cem analyze --litelement --globs \"src/Pulse*.ts\" --outdir ."
  },
  "dependencies": {
    "@pulse-music/core": "^3.0.0",
    "@pulse-music/tokens": "^3.0.0",
    "@pulse-music/types": "^3.0.0",
    "lit": "^3.3.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
