{
  "name": "@pulse-music/vue",
  "version": "3.0.0",
  "description": "Vue 3 bindings for Pulse — <PulsePlayer>, <PulseFab> and the usePulseAudio() composable.",
  "keywords": [
    "vue",
    "vue3",
    "music-player",
    "audio-player",
    "composable",
    "pulse-player"
  ],
  "license": "MIT",
  "author": "YamadaBlog",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YamadaBlog/pulse-player.git",
    "directory": "packages/vue"
  },
  "homepage": "https://yamadablog.github.io/pulse-player/",
  "bugs": {
    "url": "https://github.com/YamadaBlog/pulse-player/issues"
  },
  "type": "module",
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@pulse-music/core": "^3.0.0",
    "@pulse-music/types": "^3.0.0",
    "@pulse-music/web-component": "^3.0.0"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
