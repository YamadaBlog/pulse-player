{
  "name": "pulse-player-monorepo",
  "private": true,
  "description": "Pulse — a drop-in music player for every framework. Monorepo root.",
  "type": "module",
  "license": "MIT",
  "author": "YamadaBlog",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YamadaBlog/pulse-player.git"
  },
  "homepage": "https://yamadablog.github.io/pulse-player/",
  "workspaces": [
    "packages/types",
    "packages/core",
    "packages/tokens",
    "packages/web-component",
    "packages/react",
    "packages/svelte",
    "packages/vue",
    "packages/test-utils",
    "apps/site",
    "apps/demo-react",
    "apps/demo-svelte",
    "apps/demo-vanilla"
  ],
  "scripts": {
    "dev": "npm run dev -w @pulse-music/site",
    "build": "npm run build:packages && npm run build -w @pulse-music/site",
    "build:packages": "npm run build -w @pulse-music/types -w @pulse-music/core -w @pulse-music/tokens -w @pulse-music/web-component -w @pulse-music/react -w @pulse-music/svelte -w @pulse-music/vue",
    "preview": "npm run preview -w @pulse-music/site",
    "typecheck": "tsc -p tsconfig.json && npm run check -w @pulse-music/site && tsc -p apps/demo-react/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:packages": "node scripts/check-packages.mjs",
    "check:size": "size-limit",
    "check:assets": "node scripts/assets-license-check.mjs",
    "test:consumer": "node scripts/consumer-smoke.mjs",
    "ci": "npm run format:check && npm run lint && npm run build:packages && npm run typecheck && npm run test && npm run check:packages && npm run check:size && npm run check:assets",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build:packages && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@axe-core/playwright": "^4.13.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@size-limit/preset-small-lib": "^14.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.2",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^16.0.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^14.0.1",
    "svelte": "^5.57.1",
    "tsdown": "^0.23.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.3.11"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,vue,astro}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{css,md,json,yml,yaml,html}": "prettier --write"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "packageManager": "npm@11.6.0"
}
