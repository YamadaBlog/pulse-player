{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@pulse-music/types": ["./packages/types/src/index.ts"],
      "@pulse-music/core": ["./packages/core/src/index.ts"],
      "@pulse-music/tokens": ["./packages/tokens/src/index.ts"],
      "@pulse-music/web-component": ["./packages/web-component/src/index.ts"],
      "@pulse-music/react": ["./packages/react/src/index.ts"],
      "@pulse-music/svelte": ["./packages/svelte/src/index.ts"],
      "@pulse-music/vue": ["./packages/vue/src/index.ts"],
      "@pulse-music/test-utils": ["./packages/test-utils/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/tests",
    "vitest.config.ts",
    "playwright.config.ts",
    "e2e"
  ],
  "exclude": ["packages/react-native"]
}
