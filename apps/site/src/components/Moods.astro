---
import { VARIANTS, type NamedVariant } from '@pulse-music/tokens'
import CopyChip from './CopyChip.astro'
const moods = Object.entries(VARIANTS) as [NamedVariant, (typeof VARIANTS)[NamedVariant]][]
---

<section
  data-track="A3"
  id="moods"
  class="room"
  data-surface="b"
  aria-labelledby="moods-title"
  data-room
>
  <div class="wrap">
    <div class="track-head">
      <span class="label">A3</span>
      <span class="label">Nine moods</span>
      <span class="label">0:55</span>
    </div>

    <div class="room__grid">
      <div class="room__intro">
        <h2 id="moods-title" class="headline" data-split>
          Nine moods.
          <br />
          One attribute.
        </h2>
        <p class="lede">
          Pick one and the whole room changes key — the players on this page, the mini player
          following you, even this wall. It’s remembered for your next visit.
        </p>
        <p class="room__heard label" aria-live="polite">
          Moods heard{' '}
          <span>
            <span data-heard-count>0</span>/9
          </span>
          <span class="room__dots" aria-hidden="true">
            {moods.map(() => (
              <i></i>
            ))}
          </span>
        </p>
      </div>

      <div class="room__stage">
        <pulse-player data-mood-follow ambient-eq></pulse-player>
        <p class="room__name serif" aria-hidden="true">
          <span data-mood-name>Auto</span>
        </p>
        <div class="room__code">
          <CopyChip text={'<pulse-player variant="auto">'} />
        </div>
      </div>
    </div>

    <ul class="swatches" role="list" aria-label="Moods">
      {moods.map(([name, v], i) => (
        <li>
          <button
            class="swatch"
            type="button"
            data-mood={name}
            aria-label={v.label}
            aria-pressed="false"
            style={`--sw-bg:${name === 'transparent' ? 'repeating-conic-gradient(#2a2724 0 25%, #1c1a18 0 50%) 0 0/14px 14px' : v.background};--sw-fg:${v.foreground};--sw-accent:${v.accent}`}
          >
            <span class="swatch__n label">{String(i + 1).padStart(2, '0')}</span>
            <span class="swatch__name">{v.label}</span>
            <span class="swatch__desc">{v.description}</span>
            <span class="swatch__accent" aria-hidden="true" />
          </button>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { VARIANTS, type NamedVariant } from '@pulse-music/tokens'
  import { $, $$, onPage, reducedMotion } from '../scripts/lifecycle'
  import { applyMood, currentMood, moodsHeard } from '../scripts/mood-store'
  import { createRoll } from '../scripts/roll'
  import { EIGHTH } from '../scripts/tempo'

  onPage(() => {
    const room = $('[data-room]')
    const buttons = $$<HTMLButtonElement>('[data-mood]')
    const count = $('[data-heard-count]')
    const copy = room?.querySelector<HTMLButtonElement>('[data-copy]')
    const code = room?.querySelector('.chip code')
    if (!room || !buttons.length) return

    const render = (name: NamedVariant, heard: Set<NamedVariant>): void => {
      for (const b of buttons) {
        b.setAttribute('aria-pressed', String(b.dataset.mood === name))
        b.toggleAttribute('data-heard', heard.has(b.dataset.mood as NamedVariant))
      }
      if (count) count.textContent = String(heard.size)
      $$('.room__dots i', room).forEach((dot, i) => dot.toggleAttribute('data-on', i < heard.size))
      room.dataset.surface = VARIANTS[name].scheme === 'light' ? 'a' : 'b'
      room.dataset.scheme = VARIANTS[name].scheme
      const text = `<pulse-player variant="${name}">`
      if (copy) {
        copy.dataset.copy = text
        copy.setAttribute('aria-label', `Copy: ${text}`)
      }
      if (code) code.innerHTML = `<span aria-hidden="true">$</span> ${text.replace(/</g, '&lt;')}`
      rollName(VARIANTS[name].label)
    }

    // The mood's name rolls through a mask: out the top, in from below.
    const nameEl = $('[data-mood-name]', room)
    const roll = nameEl ? createRoll(nameEl, { duration: EIGHTH, gap: 0.05 }) : null
    let named = false
    const rollName = (label: string): void => {
      roll?.(label, !named)
      named = true
    }

    const choose = (btn: HTMLButtonElement, e: MouseEvent): void => {
      const name = btn.dataset.mood as NamedVariant
      const commit = (): void => render(name, applyMood(name))
      if (reducedMotion() || !document.startViewTransition) return commit()
      // The new mood spreads out from the point you touched.
      const r = btn.getBoundingClientRect()
      const x = e.clientX || r.left + r.width / 2
      const y = e.clientY || r.top + r.height / 2
      const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y))
      const html = document.documentElement
      html.style.setProperty('--vt-x', `${x}px`)
      html.style.setProperty('--vt-y', `${y}px`)
      html.style.setProperty('--vt-r', `${radius}px`)
      // The shared reveal (global.css): the new mood spreads from the click.
      document.startViewTransition(commit)
    }

    const onClick = (e: MouseEvent): void => {
      const btn = (e.target as Element).closest<HTMLButtonElement>('[data-mood]')
      if (btn) choose(btn, e)
    }
    room.addEventListener('click', onClick)
    render(currentMood(), moodsHeard())
    return () => room.removeEventListener('click', onClick)
  })
</script>

<style>
  .room {
    --fg: var(--mood-fg, var(--paper));
    --fg-2: color-mix(in srgb, var(--fg) 72%, transparent);
    --fg-3: color-mix(in srgb, var(--fg) 58%, transparent);
    --rule: color-mix(in srgb, var(--fg) 16%, transparent);
    --accent: var(--mood-accent, var(--signal));
    --bg: var(--mood-surface, var(--night));
    position: relative;
    padding-block: clamp(4rem, 10vw, 8rem);
    color: var(--fg);
    background: var(--mood-bg, var(--night));
  }
  :global(html[data-mood='transparent']) .room {
    background: var(--night);
  }
  .room[data-scheme='light'] {
    color-scheme: light;
  }
  .room__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    margin-top: clamp(2rem, 5vw, 4rem);
  }
  .room__intro {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  .room__heard {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
  }
  .room__dots {
    display: inline-flex;
    gap: 4px;
  }
  .room__dots i {
    width: 8px;
    height: 8px;
    border: 1px solid var(--fg-3);
    border-radius: 50%;
    /* A newly heard mood fills its dot once the wipe has passed. */
    transition:
      background-color var(--beat-4) var(--ease-out) var(--beat-2),
      border-color var(--beat-4) var(--ease-out) var(--beat-2);
  }
  .room__dots i[data-on] {
    border-color: var(--accent);
    background: var(--accent);
  }
  .room__stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.2rem;
    justify-items: start;
  }
  .room__code {
    min-width: 0;
    max-width: 100%;
  }
  .room__name {
    overflow: hidden;
    margin: -0.1em 0 -0.2em;
    padding-bottom: 0.08em;
    font-size: clamp(3.2rem, 2rem + 4vw, 6.5rem);
    line-height: 1;
    color: var(--accent);
  }
  .room__name span {
    display: inline-block;
  }
  .room__stage pulse-player {
    width: 100%;
    --pulse-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.7);
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(9, minmax(0, 1fr));
    gap: 6px;
    margin: clamp(3rem, 7vw, 5rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .swatch {
    container-type: inline-size;
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    align-content: space-between;
    gap: 0.4rem;
    width: 100%;
    aspect-ratio: 3 / 4;
    padding: 0.8rem;
    border: 0;
    border-radius: 4px;
    background: var(--sw-bg);
    color: var(--sw-fg);
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
    transition:
      transform calc(var(--beat-2) * 1.5) var(--ease-pop),
      box-shadow var(--beat-4) var(--ease-out);
  }
  .swatch:hover {
    transform: translateY(-6px);
  }
  .swatch[aria-pressed='true'] {
    transform: translateY(-14px);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.2),
      0 0 0 2px var(--sw-accent);
  }
  .swatch__n {
    opacity: 0.7;
  }
  .swatch__name {
    align-self: end;
    font-family: var(--display);
    font-weight: 760;
    font-variation-settings: 'wdth' 78;
    font-size: clamp(0.75rem, 13cqi, 1.4rem);
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .swatch__desc {
    font-size: 0.75rem;
    line-height: 1.3;
    opacity: 0.78;
  }
  .swatch__accent {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--sw-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--sw-accent) 30%, transparent);
  }
  .swatch[data-heard] .swatch__n::after {
    content: ' · heard';
  }

  @media (max-width: 1100px) {
    .swatches {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    .room__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    .swatches {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .swatch {
      aspect-ratio: 1;
      padding: 0.6rem;
    }
    .swatch__desc {
      display: none;
    }
  }
</style>
