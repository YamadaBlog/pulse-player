---
const base = import.meta.env.BASE_URL
---

<header class="head" transition:persist="head">
  <div class="head__inner">
    <a class="head__brand" href={base} aria-label="Pulse — home">
      <span class="head__disc" aria-hidden="true"></span>
      <span class="head__word">Pulse</span>
    </a>

    <p class="head__now label" aria-live="off">
      <span class="head__dot" aria-hidden="true"></span>
      <span data-now>Side A · ready</span>
    </p>

    <nav class="head__nav" aria-label="Main">
      <a class="head__gh label" href="https://github.com/YamadaBlog/pulse-player" rel="noopener">
        GitHub <span data-metric="stars-badge" aria-hidden="true"></span>
      </a>
      <button
        class="head__menu label"
        type="button"
        data-tracklist-open
        aria-haspopup="dialog"
        aria-label="Tracklist"
      >
        <span class="head__bars" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
        </span>
        Tracklist
        <span class="head__track" aria-hidden="true">
          <span data-now-track>A1</span>
        </span>
      </button>
    </nav>
  </div>
  <!-- Where the needle is on the side: the page's scroll progress. -->
  <span class="head__playhead" aria-hidden="true" data-playhead></span>
</header>

<style>
  .head {
    position: fixed;
    inset: 0 0 auto;
    z-index: 80;
    height: var(--header);
    padding-top: env(safe-area-inset-top, 0px);
    color: var(--ink);
    pointer-events: none;
  }
  :global(html[data-side='b']) .head {
    color: var(--paper);
  }
  /* A soft scrim so content scrolling underneath never fights the chrome. */
  .head::before {
    content: '';
    position: absolute;
    inset: 0 0 -24px;
    z-index: -1;
    background: linear-gradient(var(--paper) 30%, rgb(236 231 220 / 0));
    opacity: 0.92;
    pointer-events: none;
  }
  :global(html[data-side='b']) .head::before {
    background: linear-gradient(var(--night) 30%, rgb(12 11 10 / 0));
  }
  /* The header changes side in one frame — a cut (chrome.ts): a fade would
     pass through grey type on a grey scrim. Hover transitions stay. */
  :global(html.side-cut) .head,
  :global(html.side-cut) .head * {
    transition: none !important;
  }
  .head__gh [data-metric]:empty {
    display: none;
  }
  .head__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 100%;
    padding-inline: var(--gutter);
  }
  .head__inner > * {
    pointer-events: auto;
  }
  .head__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    justify-self: start;
    text-decoration: none;
  }
  .head__word {
    font-family: var(--display);
    font-weight: 820;
    font-variation-settings: 'wdth' 72;
    font-size: 1.5rem;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .head__disc {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background:
      radial-gradient(circle, var(--signal) 0 22%, transparent 23%),
      repeating-radial-gradient(circle, currentColor 0 1px, transparent 1px 3px);
    animation: spin 1.8s linear infinite;
    animation-play-state: paused;
  }
  :global(html[data-playing]) .head__disc {
    animation-play-state: running;
  }
  .head__now {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    max-width: 40vw;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .head__dot {
    position: relative;
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.35;
  }
  :global(html[data-playing]) .head__dot {
    background: var(--signal);
    opacity: 1;
  }
  /* The ping is a ring that grows and fades — transform and opacity, so
     the compositor runs it (a box-shadow would repaint every frame). */
  .head__dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--signal);
    opacity: 0;
  }
  :global(html[data-playing]) .head__dot::after {
    animation: ping calc(var(--beat) * 2) var(--ease-out) infinite;
  }
  .head__nav {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 0.5rem;
  }
  .head__gh,
  .head__menu {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 40px;
    padding: 0 1rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    background: transparent;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--beat-4) var(--ease-out),
      color var(--beat-4) var(--ease-out);
  }
  .head__gh:hover,
  .head__menu:hover {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--ink);
  }
  .head__track {
    position: relative;
    display: inline-block;
    min-width: 2.3ch;
    height: 1.2em;
    margin-left: 0.15rem;
    padding-left: 0.6rem;
    overflow: hidden;
    border-left: 1px solid currentColor;
    line-height: 1.2em;
    vertical-align: -0.2em;
    color: var(--signal-ink);
  }
  :global(html[data-side='b']) .head__track {
    color: var(--signal);
  }
  .head__track :global(span) {
    display: block;
  }
  .head__playhead {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--signal);
    transform: scaleX(0);
    transform-origin: 0 50%;
    pointer-events: none;
  }
  @supports (animation-timeline: scroll()) {
    .head__playhead {
      animation: playhead linear both;
      animation-timeline: scroll(root);
    }
  }
  @keyframes playhead {
    to {
      transform: scaleX(1);
    }
  }
  .head__bars {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 11px;
  }
  .head__bars i {
    width: 2px;
    height: 100%;
    background: currentColor;
    transform-origin: bottom;
    animation: bars var(--beat-2) var(--ease-in-out) infinite alternate;
    animation-play-state: paused;
  }
  .head__bars i:nth-child(2) {
    animation-delay: -0.3s;
  }
  .head__bars i:nth-child(3) {
    animation-delay: -0.6s;
  }
  :global(html[data-playing]) .head__bars i {
    animation-play-state: running;
  }
  @media (max-width: 720px) {
    .head__now,
    .head__gh {
      display: none;
    }
    .head__inner {
      grid-template-columns: 1fr auto;
    }
  }
  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }
  @keyframes ping {
    from {
      opacity: 0.55;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(3);
    }
  }
  @keyframes bars {
    from {
      transform: scaleY(0.3);
    }
    to {
      transform: scaleY(1);
    }
  }
</style>
