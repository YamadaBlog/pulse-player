---
const base = import.meta.env.BASE_URL
---

<header class="head" transition:persist="head">
  <div class="head__inner">
    <a class="head__brand" href={base} aria-label="Pulse — home">
      <span class="head__disc" aria-hidden="true"></span>
      <span class="head__word">Pulse</span>
    </a>

    <p class="head__now label" aria-live="off">
      <span class="head__dot" aria-hidden="true"></span>
      <span data-now>Side A · ready</span>
    </p>

    <nav class="head__nav" aria-label="Main">
      <a class="head__gh label" href="https://github.com/YamadaBlog/pulse-player" rel="noopener">
        GitHub <span data-metric="stars-badge" aria-hidden="true"></span>
      </a>
      <button class="head__menu label" type="button" data-tracklist-open aria-haspopup="dialog">
        <span class="head__bars" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
        </span>
        Tracklist
      </button>
    </nav>
  </div>
</header>

<style>
  .head {
    position: fixed;
    inset: 0 0 auto;
    z-index: 80;
    height: var(--header);
    padding-top: env(safe-area-inset-top, 0px);
    color: var(--ink);
    transition: color 0.5s var(--ease-out);
    pointer-events: none;
  }
  :global(html[data-side='b']) .head {
    color: var(--paper);
  }
  /* A soft scrim so content scrolling underneath never fights the chrome. */
  .head::before {
    content: '';
    position: absolute;
    inset: 0 0 -24px;
    z-index: -1;
    background: linear-gradient(var(--paper) 30%, rgb(236 231 220 / 0));
    opacity: 0.92;
    transition: opacity 0.5s var(--ease-out);
    pointer-events: none;
  }
  :global(html[data-side='b']) .head::before {
    background: linear-gradient(var(--night) 30%, rgb(12 11 10 / 0));
  }
  .head__gh [data-metric]:empty {
    display: none;
  }
  .head__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 100%;
    padding-inline: var(--gutter);
  }
  .head__inner > * {
    pointer-events: auto;
  }
  .head__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    justify-self: start;
    text-decoration: none;
  }
  .head__word {
    font-family: var(--display);
    font-weight: 820;
    font-variation-settings: 'wdth' 72;
    font-size: 1.5rem;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .head__disc {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background:
      radial-gradient(circle, var(--signal) 0 22%, transparent 23%),
      repeating-radial-gradient(circle, currentColor 0 1px, transparent 1px 3px);
    animation: spin 1.8s linear infinite;
    animation-play-state: paused;
  }
  :global(html[data-playing]) .head__disc {
    animation-play-state: running;
  }
  .head__now {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    max-width: 40vw;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .head__dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.35;
  }
  :global(html[data-playing]) .head__dot {
    background: var(--signal);
    opacity: 1;
    box-shadow: 0 0 0 0 var(--signal);
    animation: ping 1.4s var(--ease-out) infinite;
  }
  .head__nav {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 0.5rem;
  }
  .head__gh,
  .head__menu {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 40px;
    padding: 0 1rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    background: transparent;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 0.3s var(--ease-out),
      color 0.3s var(--ease-out);
  }
  .head__gh:hover,
  .head__menu:hover {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--ink);
  }
  .head__bars {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 11px;
  }
  .head__bars i {
    width: 2px;
    height: 100%;
    background: currentColor;
    transform-origin: bottom;
    animation: bars 0.9s var(--ease-in-out) infinite alternate;
    animation-play-state: paused;
  }
  .head__bars i:nth-child(2) {
    animation-delay: -0.3s;
  }
  .head__bars i:nth-child(3) {
    animation-delay: -0.6s;
  }
  :global(html[data-playing]) .head__bars i {
    animation-play-state: running;
  }
  @media (max-width: 720px) {
    .head__now,
    .head__gh {
      display: none;
    }
    .head__inner {
      grid-template-columns: 1fr auto;
    }
  }
  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }
  @keyframes ping {
    to {
      box-shadow: 0 0 0 7px transparent;
    }
  }
  @keyframes bars {
    from {
      transform: scaleY(0.3);
    }
    to {
      transform: scaleY(1);
    }
  }
</style>
