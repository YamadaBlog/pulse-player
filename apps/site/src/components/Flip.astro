<section class="flip" data-surface="a" data-flip aria-labelledby="flip-title">
  <div class="flip__night" aria-hidden="true"></div>
  <div class="flip__disc" aria-hidden="true">
    <div class="flip__face flip__face--a">
      <span>A</span>
    </div>
    <div class="flip__face flip__face--b">
      <span>B</span>
    </div>
  </div>
  <div class="flip__copy wrap">
    <p class="label flip__kicker">Interlude</p>
    <h2 id="flip-title" class="flip__title display">
      <span class="flip__line">Flip the</span>
      <span class="flip__line">record.</span>
    </h2>
    <p class="flip__lede">Side B is the part you hear before you see it.</p>
  </div>
</section>

<script>
  import { $, onPage, reducedMotion } from '../scripts/lifecycle'
  import { gsap } from '../scripts/motion'

  onPage(() => {
    const section = $('[data-flip]')
    if (!section) return
    if (reducedMotion()) {
      section.classList.add('is-flipped')
      section.dataset.surface = 'b'
      return
    }
    const disc = $('.flip__disc', section)!
    // Clip-path radii in px so GSAP can interpolate them (it can't tween calc()).
    const closed = (): string => `circle(${disc.offsetWidth / 2}px at 50% 50%)`
    const open = (): string =>
      `circle(${Math.hypot(section.offsetWidth, section.offsetHeight) / 2 + 2}px at 50% 50%)`
    const ctx = gsap.context(() => {
      gsap.set('.flip__night', { clipPath: closed() })
      const tl = gsap.timeline({
        paused: true,
        defaults: { ease: 'expo.inOut' },
        onStart: () => (section.dataset.surface = 'b'),
        onReverseComplete: () => (section.dataset.surface = 'a'),
      })
      tl.to('.flip__disc', { rotateY: 180, duration: 1.1 })
        .fromTo(
          '.flip__night',
          { clipPath: closed },
          { clipPath: open, duration: 1.3, immediateRender: false },
          '-=0.35',
        )
        .from('.flip__line', { yPercent: 110, duration: 1, stagger: 0.08, ease: 'expo.out' }, 0.2)

      // Played once on entry — not scrubbed: only one scene on the site follows the scrollbar.
      gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top 35%',
          end: 'bottom top',
          onEnter: () => tl.play(),
          onLeaveBack: () => tl.reverse(),
        },
      })
    }, section)
    return () => ctx.revert()
  })
</script>

<style>
  .flip {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 110svh;
    overflow: clip;
    color: var(--ink);
    background: var(--paper);
    perspective: 1400px;
  }
  .flip__night {
    position: absolute;
    inset: 0;
    background: var(--night);
    clip-path: circle(calc(min(34vmin, 300px) / 2) at 50% 50%);
  }
  .flip.is-flipped .flip__night {
    clip-path: none;
  }
  .flip__disc {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(34vmin, 300px);
    aspect-ratio: 1;
    translate: -50% -50%;
    transform-style: preserve-3d;
  }
  .flip__face {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background:
      radial-gradient(circle, transparent 0 32%, #151311 33% 35%, transparent 35.5%),
      repeating-radial-gradient(circle, #1b1917 0 1px, #0e0d0c 1px 3px);
    backface-visibility: hidden;
  }
  .flip__face span {
    display: grid;
    place-items: center;
    width: 33%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--signal);
    color: var(--ink);
    font: 820 clamp(1.2rem, 3vmin, 2.2rem) / 1 var(--display);
    font-variation-settings: 'wdth' 72;
  }
  .flip__face--b {
    transform: rotateY(180deg);
  }
  .flip__face--b span {
    background: var(--paper);
  }
  .flip.is-flipped .flip__disc {
    transform: rotateY(180deg);
  }
  .flip__copy {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: var(--gutter);
    width: 100%;
    height: 100%;
    padding-block: 12vh;
    pointer-events: none;
    mix-blend-mode: difference;
    color: #ece7dc;
  }
  .flip__kicker {
    grid-column: 1 / -1;
    align-self: start;
  }
  .flip__title {
    font-size: clamp(3.5rem, 1rem + 10vw, 11rem);
  }
  .flip__line {
    display: block;
    overflow: hidden;
  }
  .flip__lede {
    justify-self: end;
    max-width: 22ch;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.4rem, 1rem + 1.4vw, 2.4rem);
    line-height: 1.1;
  }
  @media (max-width: 700px) {
    .flip__copy {
      grid-template-columns: 1fr;
    }
    .flip__lede {
      justify-self: start;
    }
  }
</style>
