<section class="flip" data-surface="a" data-flip aria-labelledby="flip-title">
  <div class="flip__night" aria-hidden="true"></div>
  <div class="flip__disc" aria-hidden="true" data-flip-disc>
    <canvas class="flip__gl"></canvas>
    <div class="flip__face flip__face--a">
      <span>A</span>
    </div>
    <div class="flip__face flip__face--b">
      <span>B</span>
    </div>
  </div>
  <div class="flip__copy wrap">
    <p class="label flip__kicker">Interlude</p>
    <h2 id="flip-title" class="flip__title display">
      <span class="flip__line">Flip the</span>
      <span class="flip__line">record.</span>
    </h2>
    <p class="flip__lede">Side B is the part you hear before you see it.</p>
  </div>
</section>

<script>
  import { createFlipRecord } from '../scripts/flip-record'
  import { $, onPage, reducedMotion } from '../scripts/lifecycle'
  import { gsap } from '../scripts/motion'
  import { BEAT, EASE, SIXTEENTH, THIRTY_SECOND } from '../scripts/tempo'

  onPage(() => {
    const section = $('[data-flip]')
    const disc = $('[data-flip-disc]')
    const canvas = $<HTMLCanvasElement>('.flip__gl')
    if (!section || !disc || !canvas) return
    // The hero's record in WebGL; the flat CSS disc only if WebGL is missing.
    const record = createFlipRecord(canvas)
    disc.classList.toggle('is-live', !!record)

    if (reducedMotion()) {
      section.classList.add('is-flipped')
      section.dataset.surface = 'b'
      void record?.ready.then(() => record.draw(Math.PI))
      return () => record?.dispose()
    }
    // The night is a circle around the record; its radius is tweened in px.
    const night = section.querySelector<HTMLElement>('.flip__night')!
    const head = document.querySelector<HTMLElement>('.head')
    const flood = { r: 0 }
    const closed = (): number => disc.offsetWidth / 2
    const open = (): number => Math.hypot(section.offsetWidth, section.offsetHeight) / 2 + 2
    // The header changes side as the night reaches it — the moment the flood
    // touches its lower edge; its night scrim then carries the flood over the
    // last paper corners. Not when the flip starts (over paper), nor at the
    // next scroll (a light header over the night until then).
    const paintNight = (): void => {
      night.style.clipPath = `circle(${flood.r.toFixed(1)}px at 50% 50%)`
      const n = night.getBoundingClientRect()
      const cy = n.top + n.height / 2
      const hb = head?.getBoundingClientRect().bottom ?? 0
      const spreading = flood.r > closed() + 0.5 // at rest the night is just the disc
      const reached = spreading && (cy <= hb || cy - hb <= flood.r)
      const side = reached ? 'b' : 'a'
      if (section.dataset.surface === side) return
      section.dataset.surface = side
      section.dispatchEvent(new CustomEvent('surface:change', { bubbles: true }))
    }
    const turn = { flip: 0 }
    let tl: gsap.core.Timeline | null = null
    let spread: gsap.core.Tween | null = null
    const ctx = gsap.context(() => {
      flood.r = closed()
      paintNight()
      // The turn, then the night floods out of the record; the title rises
      // with the turn. One beat each, on the site's grid.
      tl = gsap.timeline({ paused: true })
      spread = gsap.fromTo(
        flood,
        { r: closed },
        {
          r: open,
          duration: BEAT * 1.5,
          ease: EASE.inOut,
          immediateRender: false,
          onUpdate: paintNight,
        },
      )
      tl.to(turn, {
        flip: Math.PI,
        duration: BEAT,
        ease: EASE.inOut,
        onUpdate: () =>
          record
            ? record.draw(turn.flip)
            : gsap.set(disc, { rotateY: (turn.flip * 180) / Math.PI }),
      })
        .add(spread, BEAT * 0.7)
        .from(
          '.flip__line',
          { yPercent: 110, duration: BEAT, stagger: THIRTY_SECOND * 2, ease: EASE.out },
          SIXTEENTH,
        )

      // Played on entry, reversed when scrolling back above it. Not scrubbed:
      // a flip is an event. Only continuous things follow the scrollbar —
      // A2's width and B2's camera.
      gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top 35%',
          end: 'bottom top',
          onEnter: () => tl?.play(),
          onLeaveBack: () => tl?.reverse(),
        },
      })
    }, section)
    // A resize changes both radii: re-fit the night while it is at rest (and
    // let the next spread measure again).
    const onResize = (): void => {
      if (!tl || !spread || tl.isActive()) return
      spread.invalidate()
      flood.r = spread.progress() === 1 ? open() : closed()
      paintNight()
    }
    addEventListener('resize', onResize)
    return () => {
      removeEventListener('resize', onResize)
      // Swapped out: stop, don't restore a DOM that is going away.
      ctx.kill()
      record?.dispose()
    }
  })
</script>

<style>
  .flip {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 110svh;
    overflow: clip;
    color: var(--ink);
    background: var(--paper);
    perspective: 1400px;
  }
  .flip__night {
    position: absolute;
    inset: 0;
    background: var(--night);
    clip-path: circle(calc(min(34vmin, 300px) / 2) at 50% 50%);
  }
  .flip.is-flipped .flip__night {
    clip-path: none;
  }
  .flip__disc {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(34vmin, 300px);
    aspect-ratio: 1;
    translate: -50% -50%;
    transform-style: preserve-3d;
  }
  .flip__face {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background:
      radial-gradient(circle, transparent 0 32%, #151311 33% 35%, transparent 35.5%),
      repeating-radial-gradient(circle, #1b1917 0 1px, #0e0d0c 1px 3px);
    backface-visibility: hidden;
  }
  .flip__face span {
    display: grid;
    place-items: center;
    width: 33%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--signal);
    color: var(--ink);
    font: 820 clamp(1.2rem, 3vmin, 2.2rem) / 1 var(--display);
    font-variation-settings: 'wdth' 72;
  }
  .flip__face--b {
    transform: rotateY(180deg);
  }
  .flip__face--b span {
    background: var(--paper);
  }
  .flip.is-flipped .flip__disc:not(.is-live) {
    transform: rotateY(180deg);
  }
  /* WebGL record: the canvas is larger than the disc (room for its shadow). */
  .flip__gl {
    position: absolute;
    left: -12.5%;
    top: -12.5%;
    width: 125%;
    height: 125%;
    display: none;
  }
  .flip__disc.is-live .flip__gl {
    display: block;
  }
  .flip__disc.is-live .flip__face {
    display: none;
  }
  .flip__copy {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: var(--gutter);
    width: 100%;
    height: 100%;
    padding-block: 12vh;
    pointer-events: none;
    mix-blend-mode: difference;
    color: #ece7dc;
  }
  .flip__kicker {
    grid-column: 1 / -1;
    align-self: start;
  }
  .flip__title {
    font-size: clamp(3.5rem, 1rem + 10vw, 11rem);
  }
  .flip__line {
    display: block;
    overflow: hidden;
  }
  .flip__lede {
    justify-self: end;
    max-width: 22ch;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.4rem, 1rem + 1.4vw, 2.4rem);
    line-height: 1.1;
  }
  @media (max-width: 700px) {
    .flip__copy {
      grid-template-columns: 1fr;
    }
    .flip__lede {
      justify-self: start;
    }
  }
</style>
