<section class="flip" data-surface="a" data-flip data-stage-window aria-labelledby="flip-title">
  <div class="flip__night" aria-hidden="true"></div>
  <div class="flip__disc" aria-hidden="true" data-flip-disc>
    <div class="flip__face flip__face--a">
      <span>A</span>
    </div>
    <div class="flip__face flip__face--b">
      <span>B</span>
    </div>
  </div>
  <div class="flip__copy wrap">
    <p class="label flip__kicker">Interlude</p>
    <h2 id="flip-title" class="flip__title display">
      <span class="flip__line">Flip the</span>
      <span class="flip__line">record.</span>
    </h2>
    <p class="flip__lede">Side B is the part you hear before you see it.</p>
  </div>
</section>

<script>
  import { $, onPage, reducedMotion } from '../scripts/lifecycle'
  import { gsap } from '../scripts/motion'
  import { flip } from '../scripts/stage/director'
  import { onStageFrame, stage, stageLive } from '../scripts/stage/stage'
  import { BEAT, EASE, EIGHTH, SIXTEENTH, THIRTY_SECOND } from '../scripts/tempo'

  /**
   * The interlude. With the stage, it is the same record, in its box: it
   * lifts off the table, turns over in the air while the camera leans in,
   * lands on side B, and the night spreads over the table from under it like
   * ink. Without WebGL2: the flat CSS disc turns and a circle of night grows.
   */
  onPage(() => {
    const section = $('[data-flip]')
    const disc = $('[data-flip-disc]')
    if (!section || !disc) return
    const head = document.querySelector<HTMLElement>('.head')
    const setSide = (side: 'a' | 'b'): void => {
      if (section.dataset.surface === side) return
      section.dataset.surface = side
      section.dispatchEvent(new CustomEvent('surface:change', { bubbles: true }))
    }
    return stageLive() ? staged() : flat()

    function staged(): () => void {
      section!.classList.add('is-staged')
      flip.dock = disc
      // The night must reach the farthest corner of the screen, in record radii.
      const reach = (): number => {
        const { x, y, r } = stage.shot
        return (Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y)) / r) * 1.06
      }
      // The header changes side as the ink reaches its lower edge.
      const offFrame = onStageFrame(() => {
        if (flip.dock !== disc || stage.flood < 1.02) return setSide('a')
        const hb = head?.getBoundingClientRect().bottom ?? 0
        const reached = stage.shot.y <= hb || stage.flood * stage.shot.r >= stage.shot.y - hb
        setSide(reached ? 'b' : 'a')
      })
      if (reducedMotion()) {
        stage.flip = Math.PI
        stage.flood = 40
        stage.night = 1
        return () => {
          offFrame()
          flip.dock = null
          stage.flip = 0
          stage.flood = -1
          stage.night = 0
        }
      }
      stage.flood = 1
      const tl = gsap.timeline({ paused: true, defaults: { ease: EASE.inOut } })
      // Lift off, turn over in the air (one beat), land — the camera leans in
      // to see it happen, and straightens as the record settles.
      tl.to(stage, { lift: 1.3, duration: BEAT * 0.5, ease: EASE.out }, 0)
        .to(stage, { flip: Math.PI, duration: BEAT }, 0)
        .to(stage, { lift: 0.1, duration: BEAT * 0.5, ease: EASE.in }, BEAT * 0.5)
        .to(flip, { el: 1.02, depth: 0.6, duration: BEAT * 0.6 }, 0)
        .to(flip, { el: Math.PI / 2, depth: 0, duration: BEAT * 0.9 }, BEAT * 0.6)
        // The ink, from under the record to the corners.
        .fromTo(
          stage,
          { flood: 1 },
          { flood: reach, night: 1, duration: BEAT * 1.5, immediateRender: false },
          BEAT * 0.7,
        )
        .from(
          '.flip__line',
          { yPercent: 110, duration: BEAT, stagger: THIRTY_SECOND * 2, ease: EASE.out },
          SIXTEENTH,
        )
      const trigger = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top 15%',
          end: 'bottom top',
          onEnter: () => tl.play(),
          onLeaveBack: () => tl.reverse(),
        },
      })
      return () => {
        offFrame()
        tl.kill()
        trigger.scrollTrigger?.kill()
        trigger.kill()
        flip.dock = null
        Object.assign(stage, { flip: 0, flood: -1, night: 0, lift: 0.1 })
        Object.assign(flip, { el: Math.PI / 2, depth: 0 })
      }
    }

    function flat(): () => void {
      // No WebGL2: the CSS disc turns, and a circle of night grows from it.
      const night = section!.querySelector<HTMLElement>('.flip__night')!
      if (reducedMotion()) {
        section!.classList.add('is-flipped')
        setSide('b')
        return () => undefined
      }
      const flood = { r: disc!.offsetWidth / 2 }
      const paint = (): void => {
        night.style.clipPath = `circle(${flood.r.toFixed(1)}px at 50% 50%)`
        const n = night.getBoundingClientRect()
        const cy = n.top + n.height / 2
        const hb = head?.getBoundingClientRect().bottom ?? 0
        setSide(
          flood.r > disc!.offsetWidth / 2 + 0.5 && (cy <= hb || cy - hb <= flood.r) ? 'b' : 'a',
        )
      }
      paint()
      const turn = { deg: 0 }
      const tl = gsap.timeline({ paused: true, defaults: { ease: EASE.inOut } })
      tl.to(turn, {
        deg: 180,
        duration: BEAT,
        onUpdate: () => void gsap.set(disc!, { rotateY: turn.deg }),
      })
        .to(
          flood,
          {
            r: () => Math.hypot(section!.offsetWidth, section!.offsetHeight) / 2 + 2,
            duration: BEAT * 1.5,
            onUpdate: paint,
          },
          BEAT * 0.7,
        )
        .from(
          '.flip__line',
          { yPercent: 110, duration: EIGHTH * 2, stagger: THIRTY_SECOND * 2, ease: EASE.out },
          SIXTEENTH,
        )
      const trigger = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top 15%',
          end: 'bottom top',
          onEnter: () => tl.play(),
          onLeaveBack: () => tl.reverse(),
        },
      })
      return () => {
        tl.kill()
        trigger.scrollTrigger?.kill()
        trigger.kill()
      }
    }
  })
</script>

<style>
  .flip {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 110svh;
    overflow: clip;
    color: var(--ink);
    background: var(--paper);
    perspective: 1400px;
  }
  .flip__night {
    position: absolute;
    inset: 0;
    background: var(--night);
    clip-path: circle(calc(min(34vmin, 300px) / 2) at 50% 50%);
  }
  .flip.is-flipped .flip__night {
    clip-path: none;
  }
  .flip__disc {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(34vmin, 300px);
    aspect-ratio: 1;
    translate: -50% -50%;
    transform-style: preserve-3d;
  }
  .flip__face {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background:
      radial-gradient(circle, transparent 0 32%, #151311 33% 35%, transparent 35.5%),
      repeating-radial-gradient(circle, #1b1917 0 1px, #0e0d0c 1px 3px);
    backface-visibility: hidden;
  }
  .flip__face span {
    display: grid;
    place-items: center;
    width: 33%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--signal);
    color: var(--ink);
    font: 820 clamp(1.2rem, 3vmin, 2.2rem) / 1 var(--display);
    font-variation-settings: 'wdth' 72;
  }
  .flip__face--b {
    transform: rotateY(180deg);
  }
  .flip__face--b span {
    background: var(--paper);
  }
  .flip.is-flipped .flip__disc {
    transform: rotateY(180deg);
  }
  /* With the stage, the section is a window: the record, the table and
     the night are the scene's (the flat disc and circle are the fallback). */
  .flip.is-staged {
    background: transparent;
  }
  .flip.is-staged .flip__night,
  .flip.is-staged .flip__face {
    display: none;
  }
  .flip__copy {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: var(--gutter);
    width: 100%;
    height: 100%;
    padding-block: 12vh;
    pointer-events: none;
    mix-blend-mode: difference;
    color: #ece7dc;
  }
  .flip__kicker {
    grid-column: 1 / -1;
    align-self: start;
  }
  .flip__title {
    font-size: clamp(3.5rem, 1rem + 10vw, 11rem);
  }
  .flip__line {
    display: block;
    overflow: hidden;
  }
  .flip__lede {
    justify-self: end;
    max-width: 22ch;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.4rem, 1rem + 1.4vw, 2.4rem);
    line-height: 1.1;
  }
  @media (max-width: 700px) {
    .flip__copy {
      grid-template-columns: 1fr;
    }
    .flip__lede {
      justify-self: start;
    }
  }
</style>
