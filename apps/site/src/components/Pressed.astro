---
const repo = 'https://github.com/YamadaBlog/pulse-player'
const packages = [
  { name: '@pulse-music/web-component', role: 'The elements' },
  { name: '@pulse-music/core', role: 'Audio engine' },
  { name: '@pulse-music/react', role: 'React bindings' },
  { name: '@pulse-music/vue', role: 'Vue bindings' },
  { name: '@pulse-music/svelte', role: 'Svelte bindings' },
  { name: '@pulse-music/tokens', role: 'Moods & motion' },
  { name: '@pulse-music/types', role: 'Shared types' },
]
const stats = [
  { key: 'stars', label: 'Stars' },
  { key: 'forks', label: 'Forks' },
  { key: 'issues', label: 'Open issues' },
  { key: 'downloads', label: 'npm / month' },
  { key: 'version', label: 'Latest' },
  { key: 'pushed', label: 'Last pressed' },
]
---

<section id="pressed" class="side-b pressed" data-surface="b" aria-labelledby="pressed-title">
  <div class="wrap">
    <div class="track-head">
      <span class="label">C1</span>
      <span class="label">Pressings</span>
      <span class="label">0:35</span>
    </div>

    <div class="pressed__grid">
      <div class="pressed__copy">
        <h2 id="pressed-title" class="headline" data-split>
          Open source.
          <br />
          Pressed in <span class="serif">public.</span>
        </h2>
        <p class="lede">
          MIT-licensed, typed end to end, tested in real browsers. Every change goes through lint,
          unit, end-to-end and accessibility checks before it’s pressed.
        </p>
        <div class="pressed__actions">
          <a class="btn" href={repo} rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
              ></path>
            </svg>
            View the source
          </a>
          <a class="btn btn--ghost" href={`${repo}/blob/main/CONTRIBUTING.md`} rel="noopener">
            Contribute
          </a>
        </div>
      </div>

      <article class="matrix" aria-label="Repository">
        <header class="matrix__head">
          <span class="label">PM—001 · Matrix</span>
          <a class="matrix__repo" href={repo} rel="noopener">
            YamadaBlog/pulse-player
          </a>
        </header>
        <dl class="matrix__stats">
          {stats.map((s) => (
            <div>
              <dt class="label">{s.label}</dt>
              <dd data-metric={s.key}>—</dd>
            </div>
          ))}
        </dl>
        <ol class="matrix__pkgs">
          {packages.map((p, i) => (
            <li>
              <span class="label">{String(i + 1).padStart(2, '0')}</span>
              <a href={`https://www.npmjs.com/package/${p.name}`} rel="noopener">
                {p.name}
              </a>
              <span class="muted">{p.role}</span>
            </li>
          ))}
        </ol>
      </article>
    </div>

    <p class="signature">
      <span class="label">Pressed by</span>
      <a class="signature__name" href="https://github.com/YamadaBlog" rel="noopener">
        Loïc <span class="serif">— @YamadaBlog</span>
      </a>
      <span class="muted">Design, engine, elements, and this website.</span>
    </p>
  </div>
</section>

<style>
  .pressed {
    padding-block: clamp(4rem, 10vw, 8rem);
  }
  .pressed__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    margin-top: clamp(2rem, 5vw, 4rem);
  }
  .pressed__copy {
    display: grid;
    gap: 1.5rem;
  }
  .pressed__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .matrix {
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: var(--night-2);
  }
  .matrix__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 1.1rem 1.4rem;
    border-bottom: 1px solid var(--rule);
    color: var(--fg-2);
  }
  .matrix__repo {
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--fg);
  }
  .matrix__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    border-bottom: 1px solid var(--rule);
  }
  .matrix__stats div {
    display: grid;
    gap: 0.3rem;
    padding: 1.1rem 1.4rem;
  }
  .matrix__stats div:nth-child(-n + 3) {
    border-bottom: 1px solid var(--rule);
  }
  .matrix__stats div:not(:nth-child(3n)) {
    border-right: 1px solid var(--rule);
  }
  .matrix__stats dt {
    color: var(--fg-3);
  }
  .matrix__stats dd {
    margin: 0;
    font-family: var(--display);
    font-weight: 760;
    font-variation-settings: 'wdth' 76;
    font-size: clamp(1.4rem, 1rem + 1.2vw, 2.2rem);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .matrix__pkgs {
    display: grid;
    margin: 0;
    padding: 0.6rem 0;
    list-style: none;
  }
  .matrix__pkgs li {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr) auto;
    gap: 0.8rem;
    align-items: baseline;
    padding: 0.55rem 1.4rem;
  }
  .matrix__pkgs .label {
    color: var(--fg-3);
  }
  .matrix__pkgs a {
    overflow: hidden;
    font-family: var(--mono);
    font-size: 0.82rem;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-decoration: none;
  }
  .matrix__pkgs a:hover {
    color: var(--signal);
    text-decoration: underline;
  }
  .matrix__pkgs .muted {
    font-size: 0.82rem;
  }
  .signature {
    display: grid;
    gap: 0.6rem;
    margin-top: clamp(4rem, 9vw, 8rem);
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
  .signature__name {
    width: fit-content;
    font-family: var(--display);
    font-weight: 820;
    font-variation-settings: 'wdth' 72;
    font-size: clamp(3rem, 1rem + 8vw, 9rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.4s var(--ease-out);
  }
  .signature__name .serif {
    font-size: 0.42em;
    letter-spacing: 0;
  }
  .signature__name:hover {
    color: var(--signal);
  }
  @media (max-width: 900px) {
    .pressed__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .matrix__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .matrix__stats div {
      border: 0 !important;
      border-bottom: 1px solid var(--rule) !important;
    }
    .matrix__pkgs li {
      grid-template-columns: 2rem minmax(0, 1fr);
    }
    .matrix__pkgs .muted {
      display: none;
    }
  }
</style>
