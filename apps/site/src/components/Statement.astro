---
import { VARIANTS } from '@pulse-music/tokens'
const swatches = (['sunset', 'midnight', 'aurora', 'vinyl', 'light'] as const).map(
  (name) => VARIANTS[name],
)
const chapters = [
  {
    n: 'A2',
    title: 'Grows with the page',
    line: 'Card, compact, disc — no breakpoints.',
    href: '#grows',
  },
  { n: 'A3', title: 'Nine moods', line: 'Themes that retint the room.', href: '#moods' },
  { n: 'B1', title: 'Follows you', line: 'A mini player that never gets lost.', href: '#follows' },
  {
    n: 'B2',
    title: 'Listens back',
    line: 'The real spectrum, sixty times a second.',
    href: '#listens',
  },
  {
    n: 'B3',
    title: 'Speaks every framework',
    line: 'One element, five dialects.',
    href: '#dialects',
  },
  {
    n: 'B4',
    title: 'Built to be heard',
    line: 'Keyboard, screen readers, lock screens.',
    href: '#heard',
  },
]
---

<section data-track="A1" class="statement" data-surface="a" aria-labelledby="statement-title">
  <div class="wrap">
    <div class="track-head">
      <span class="label">A1</span>
      <span class="label">Drop the needle</span>
      <span class="label">0:40</span>
    </div>
    <h2 id="statement-title" class="sr-only">
      What Pulse is
    </h2>
    <p class="statement__text" data-reveal>
      Pulse is one element that shrinks to a<span class="inline-disc" aria-hidden="true"></span>
      disc, stretches into a hero card, wears
      <span class="inline-moods" aria-hidden="true">
        {swatches.map((v) => (
          <i style={`background:${v.background}`}></i>
        ))}
      </span>
      nine moods and plays in <em class="serif">every</em> framework — while the music it plays
      moves everything around it.
    </p>

    <ol class="chapters">
      {chapters.map((c, i) => (
        <li data-reveal={i}>
          <a href={c.href}>
            <span class="label">{c.n}</span>
            <span class="chapters__title">{c.title}</span>
            <span class="chapters__line">{c.line}</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .statement {
    padding-block: clamp(4rem, 10vw, 9rem) clamp(3rem, 8vw, 7rem);
  }
  .statement__text {
    max-width: 22ch;
    margin-top: clamp(2rem, 5vw, 4rem);
    font-family: var(--display);
    font-weight: 560;
    font-variation-settings: 'wdth' 92;
    font-size: clamp(2rem, 1rem + 4.2vw, 5.4rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .statement__text em {
    font-size: 1.08em;
  }
  .inline-disc {
    display: inline-block;
    width: 0.82em;
    height: 0.82em;
    vertical-align: -0.08em;
    border-radius: 50%;
    background:
      radial-gradient(circle, var(--ink) 0 5%, var(--signal) 6% 30%, transparent 31%),
      repeating-radial-gradient(circle, #24211e 0 1px, #0f0e0d 1px 3px);
    box-shadow: 0 0.06em 0.16em rgb(19 18 16 / 0.35);
    animation: disc-spin 1.8s linear infinite;
    animation-play-state: paused;
  }
  :global(html[data-playing]) .inline-disc {
    animation-play-state: running;
  }
  @keyframes disc-spin {
    to {
      rotate: 360deg;
    }
  }
  .inline-moods {
    display: inline-flex;
    vertical-align: 0.02em;
  }
  .inline-moods i {
    width: 0.62em;
    height: 0.62em;
    margin-right: -0.18em;
    border-radius: 50%;
    box-shadow: 0 0 0 0.05em var(--paper);
  }
  .chapters {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: clamp(3rem, 7vw, 6rem) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }
  .chapters li {
    border-bottom: 1px solid var(--rule);
  }
  .chapters li:not(:nth-child(3n)) {
    border-right: 1px solid var(--rule);
  }
  .chapters a {
    display: grid;
    gap: 0.4rem;
    min-height: 100%;
    padding: 1.4rem 1.2rem 1.6rem;
    text-decoration: none;
    transition: background-color var(--beat-2) var(--ease-out);
  }
  .chapters a:hover {
    background: var(--paper-2);
  }
  .chapters__title {
    font-family: var(--display);
    font-weight: 740;
    font-variation-settings: 'wdth' 80;
    font-size: clamp(1.4rem, 1rem + 1vw, 2rem);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    transition: font-variation-settings calc(var(--beat-2) * 1.5) var(--ease-out);
  }
  .chapters a:hover .chapters__title {
    font-variation-settings: 'wdth' 110;
  }
  .chapters__line {
    color: var(--fg-2);
  }
  @media (max-width: 900px) {
    .chapters {
      grid-template-columns: minmax(0, 1fr);
    }
    .chapters li:not(:nth-child(3n)) {
      border-right: 0;
    }
  }
</style>
