---
import { highlight } from '../lib/highlight'
import { FRAMEWORKS, snippet, type PlayerConfig } from '../lib/snippets'
import CopyChip from './CopyChip.astro'

const config: PlayerConfig = {
  variant: 'auto',
  accent: null,
  ambientEq: true,
  grain: true,
  resizable: false,
}
const panels = FRAMEWORKS.map((f) => ({ ...f, html: highlight(snippet(f.id, config)) }))
---

<section
  data-track="B3"
  id="dialects"
  class="side-b dialects"
  data-surface="b"
  aria-labelledby="dialects-title"
  data-dialects
>
  <div class="wrap">
    <div class="track-head">
      <span class="label">B3</span>
      <span class="label">Speaks every framework</span>
      <span class="label">0:50</span>
    </div>

    <div class="dialects__grid">
      <div class="dialects__copy">
        <h2 id="dialects-title" class="headline">
          One element.
          <br />
          Speaks&nbsp;
          <span class="roll" aria-hidden="true">
            <span class="roll__col" data-roll>
              {panels.map((p) => (
                <span>{p.label}</span>
              ))}
            </span>
          </span>
          <span class="sr-only">every framework</span>
        </h2>
        <p class="lede">
          The engine and the player are framework-free. Thin, typed wrappers give Vue, React and
          Svelte their own idioms; Angular and plain HTML use the element as-is. Same audio, same
          events, same types.
        </p>
      </div>

      <div class="term">
        <div class="term__tabs" role="tablist" aria-label="Framework">
          {panels.map((p, i) => (
            <button
              role="tab"
              type="button"
              id={`tab-${p.id}`}
              aria-controls={`panel-${p.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-tab={i}
            >
              {p.label}
            </button>
          ))}
          <span class="term__ink" aria-hidden="true" data-ink></span>
        </div>
        {panels.map((p, i) => (
          <div
            class="term__panel"
            role="tabpanel"
            id={`panel-${p.id}`}
            aria-labelledby={`tab-${p.id}`}
            tabindex="0"
            hidden={i !== 0}
          >
            <pre><code set:html={p.html} /></pre>
            <CopyChip text={p.install} />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { $, $$, onPage } from '../scripts/lifecycle'
  import { EASING } from '@pulse-music/tokens'
  import { EIGHTH } from '../scripts/tempo'

  onPage(() => {
    const root = $('[data-dialects]')
    if (!root) return
    const tabs = $$<HTMLButtonElement>('[role="tab"]', root)
    const panels = $$('[role="tabpanel"]', root)
    const ink = $('[data-ink]', root)
    const roll = $('[data-roll]', root)

    const place = (i: number): void => {
      const tab = tabs[i]
      if (ink && tab) {
        ink.style.width = `${tab.offsetWidth}px`
        ink.style.transform = `translateX(${tab.offsetLeft}px)`
      }
      if (roll) roll.style.transform = `translateY(${-i * 100}%)`
    }

    const select = (i: number, focus = false): void => {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(i === j))
        t.tabIndex = i === j ? 0 : -1
      })
      panels.forEach((p, j) => {
        p.hidden = i !== j
        if (i === j)
          p.animate?.(
            [
              { opacity: 0, transform: 'translateY(8px)' },
              { opacity: 1, transform: 'none' },
            ],
            { duration: EIGHTH * 1000, easing: EASING.out },
          )
      })
      place(i)
      if (focus) tabs[i]?.focus()
    }

    const current = (): number => tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true')
    const onClick = (e: Event): void => {
      const tab = (e.target as Element).closest<HTMLButtonElement>('[role="tab"]')
      if (tab) select(Number(tab.dataset.tab))
    }
    const onKey = (e: KeyboardEvent): void => {
      if (!(e.target as Element).matches('[role="tab"]')) return
      const n = tabs.length
      const map: Record<string, number> = {
        ArrowRight: current() + 1,
        ArrowLeft: current() - 1 + n,
        Home: 0,
        End: n - 1,
      }
      if (!(e.key in map)) return
      e.preventDefault()
      select(map[e.key]! % n, true)
    }
    const onResize = (): void => place(Math.max(0, current()))
    root.addEventListener('click', onClick)
    root.addEventListener('keydown', onKey)
    addEventListener('resize', onResize)
    void document.fonts?.ready.then(onResize)
    place(0)
    return () => {
      root.removeEventListener('click', onClick)
      root.removeEventListener('keydown', onKey)
      removeEventListener('resize', onResize)
    }
  })
</script>

<style>
  .dialects {
    padding-block: clamp(4rem, 10vw, 8rem);
  }
  .dialects__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    margin-top: clamp(2rem, 5vw, 4rem);
  }
  .dialects__copy {
    display: grid;
    gap: 1.5rem;
  }
  .roll {
    display: inline-block;
    height: 0.95em;
    overflow: hidden;
    vertical-align: bottom;
    color: var(--signal);
  }
  .roll__col {
    display: grid;
    transition: transform var(--beat) cubic-bezier(0.7, 0, 0.2, 1.2);
  }
  .roll__col span {
    height: 0.95em;
    line-height: 0.95;
  }
  .term {
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: var(--night-2);
    overflow: hidden;
  }
  .term__tabs {
    position: relative;
    display: flex;
    overflow-x: auto;
    border-bottom: 1px solid var(--rule);
    scrollbar-width: none;
  }
  .term__tabs button {
    flex: none;
    min-height: 48px;
    padding: 0 1.2rem;
    border: 0;
    background: none;
    color: var(--fg-2);
    font: 500 0.78rem var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color var(--beat-4) var(--ease-out);
  }
  .term__tabs button[aria-selected='true'] {
    color: var(--fg);
  }
  .term__tabs button:focus-visible {
    outline-offset: -4px;
  }
  .term__ink {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 0;
    height: 2px;
    background: var(--signal);
    transition:
      transform calc(var(--beat-2) * 1.5) var(--ease-gentle),
      width calc(var(--beat-2) * 1.5) var(--ease-out);
  }
  .term__panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: start;
    gap: 1rem;
    padding: 1.2rem 1.4rem 1.4rem;
  }
  .term__panel:focus-visible {
    outline-offset: -4px;
  }
  .term__panel pre {
    justify-self: stretch;
    margin: 0;
    min-height: 17em;
    overflow-x: auto;
    font: 0.82rem/1.7 var(--mono);
    color: var(--fg);
  }
  .term__panel :global(.tok-tag) {
    color: #ff8a5c;
  }
  .term__panel :global(.tok-attr) {
    color: #f3c77b;
  }
  .term__panel :global(.tok-string) {
    color: #9fd8a4;
  }
  .term__panel :global(.tok-keyword) {
    color: var(--signal);
  }
  .term__panel :global(.tok-comment) {
    color: var(--fg-3);
  }
  @media (max-width: 900px) {
    .dialects__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
