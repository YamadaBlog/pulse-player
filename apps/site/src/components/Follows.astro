---
const base = import.meta.env.BASE_URL
const corners = [
  { id: 'top-start', label: 'Top left' },
  { id: 'top-end', label: 'Top right' },
  { id: 'bottom-start', label: 'Bottom left' },
  { id: 'bottom-end', label: 'Bottom right' },
]
---

<section
  data-track="B1"
  id="follows"
  class="side-b follows"
  data-surface="b"
  aria-labelledby="follows-title"
  data-follows
>
  <div class="wrap">
    <div class="track-head">
      <span class="label">B1</span>
      <span class="label">Follows you</span>
      <span class="label">0:45</span>
    </div>

    <div class="follows__grid">
      <div class="follows__copy">
        <h2 id="follows-title" class="headline" data-split>
          Scroll away.
          <br />
          It comes <span class="serif">with&nbsp;you.</span>
        </h2>
        <p class="lede">
          <code>&lt;pulse-fab&gt;</code> shares the same audio session as every player on the page.
          It appears when the music starts, can be dragged anywhere, snaps to the nearest corner and
          remembers where you left it — even across pages.
        </p>
        <p class="follows__note label">
          It’s already here. <span data-follows-state>Drop the needle to meet it.</span>
        </p>
      </div>

      <div class="follows__bench">
        <div class="screen" aria-hidden="true" data-screen>
          <span class="screen__bar"></span>
          <span class="screen__line" style="--w:62%"></span>
          <span class="screen__line" style="--w:48%"></span>
          <span class="screen__line" style="--w:71%"></span>
          <span class="screen__block"></span>
          <span class="screen__fab" data-screen-fab></span>
        </div>

        <fieldset class="corners">
          <legend class="label">Placement</legend>
          {corners.map((c) => (
            <label class="corner">
              <input
                type="radio"
                name="fab-placement"
                value={c.id}
                checked={c.id === 'bottom-end'}
              />
              <span>{c.label}</span>
            </label>
          ))}
        </fieldset>

        <div class="follows__toggles">
          <label class="toggle">
            <input type="checkbox" data-fab-opt="pulso" checked />
            <span>Heartbeat ripple</span>
          </label>
          <label class="toggle">
            <input type="checkbox" data-fab-opt="always" />
            <span>Show before playing</span>
          </label>
        </div>

        <pre class="follows__code"><code data-fab-code>&lt;pulse-fab placement="bottom-end" pulso&gt;&lt;/pulse-fab&gt;</code></pre>
        <a class="btn btn--ghost" href={`${base}playground/`}>
          Change page — keep the music
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { engine } from '../scripts/audio'
  import { $, $$, onPage } from '../scripts/lifecycle'

  onPage(() => {
    const root = $('[data-follows]')
    const fab = $('pulse-fab')
    const screen = $('[data-screen]')
    const code = $('[data-fab-code]')
    const note = $('[data-follows-state]')
    if (!root || !fab || !screen || !code) return

    const radios = $$<HTMLInputElement>('input[name="fab-placement"]', root)
    const pulso = $<HTMLInputElement>('[data-fab-opt="pulso"]', root)!
    const always = $<HTMLInputElement>('[data-fab-opt="always"]', root)!

    const current = fab.getAttribute('placement') ?? 'bottom-end'
    for (const r of radios) r.checked = r.value === current
    pulso.checked = fab.hasAttribute('pulso')
    always.checked = fab.getAttribute('reveal') === 'always'

    const sync = (): void => {
      const placement = radios.find((r) => r.checked)?.value ?? 'bottom-end'
      fab.setAttribute('placement', placement)
      fab.toggleAttribute('pulso', pulso.checked)
      if (always.checked) fab.setAttribute('reveal', 'always')
      else fab.removeAttribute('reveal')
      screen.dataset.corner = placement
      const attrs = [
        `placement="${placement}"`,
        pulso.checked && 'pulso',
        always.checked && 'reveal="always"',
      ]
      code.textContent = `<pulse-fab ${attrs.filter(Boolean).join(' ')}></pulse-fab>`
    }
    const onState = (): void => {
      screen.toggleAttribute('data-live', engine.state.isPlaying || always.checked)
      if (note)
        note.textContent = engine.state.isPlaying
          ? 'Look at the corner of your screen.'
          : always.checked
            ? 'Look at the corner of your screen.'
            : 'Drop the needle to meet it.'
    }
    const onChange = (): void => {
      sync()
      onState()
    }
    root.addEventListener('change', onChange)
    const off = engine.onStateChange(onState)
    sync()
    onState()
    return () => {
      root.removeEventListener('change', onChange)
      off()
    }
  })
</script>

<style>
  .follows {
    padding-block: clamp(4rem, 10vw, 9rem);
  }
  .follows__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    margin-top: clamp(2rem, 5vw, 4rem);
  }
  .follows__copy {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  .follows__copy code {
    font-family: var(--mono);
    font-size: 0.85em;
    color: var(--accent);
  }
  .follows__note {
    color: var(--fg-2);
  }
  .follows__bench {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .screen {
    --inset: 7%;
    position: relative;
    display: grid;
    align-content: start;
    gap: 10px;
    width: 100%;
    aspect-ratio: 16 / 10;
    padding: 12% 10%;
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: var(--night-2);
    overflow: hidden;
  }
  .screen__bar {
    position: absolute;
    inset: 0 0 auto;
    height: 7%;
    border-bottom: 1px solid var(--rule);
  }
  .screen__line {
    width: var(--w);
    height: 8px;
    border-radius: 4px;
    background: var(--rule);
  }
  .screen__block {
    width: 80%;
    height: 34%;
    margin-top: 8px;
    border-radius: 6px;
    background: var(--rule);
    opacity: 0.6;
  }
  .screen__fab {
    position: absolute;
    top: var(--inset);
    left: var(--inset);
    width: 12%;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle, var(--signal) 0 30%, transparent 31%),
      repeating-radial-gradient(circle, #2a2724 0 1px, #111 1px 3px);
    box-shadow: 0 10px 24px -8px rgb(0 0 0 / 0.8);
    scale: 0.6;
    opacity: 0.4;
    transition:
      left var(--beat) var(--ease-gentle),
      top var(--beat) var(--ease-gentle),
      scale calc(var(--beat-2) * 1.5) var(--ease-pop),
      opacity var(--beat-2) var(--ease-out);
  }
  .screen[data-live] .screen__fab {
    scale: 1;
    opacity: 1;
  }
  .screen[data-live] .screen__fab::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid var(--signal);
    animation: ping calc(var(--beat) * 2) var(--ease-out) infinite;
  }
  @keyframes ping {
    to {
      scale: 1.8;
      opacity: 0;
    }
  }
  .screen[data-corner$='end'] .screen__fab {
    left: calc(100% - var(--inset) - 12%);
  }
  .screen[data-corner^='bottom'] .screen__fab {
    top: calc(100% - var(--inset) - 12% * 1.6);
  }

  .corners {
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .corners legend {
    margin-bottom: 0.6rem;
    color: var(--fg-2);
  }
  .corner,
  .toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 0.78rem;
    cursor: pointer;
    transition:
      border-color var(--beat-4) var(--ease-out),
      background-color var(--beat-4) var(--ease-out);
  }
  .corner input,
  .toggle input {
    accent-color: var(--signal);
  }
  .corner:has(:checked),
  .toggle:has(:checked) {
    border-color: var(--signal);
    background: rgb(255 79 26 / 0.08);
  }
  .corner:has(:focus-visible),
  .toggle:has(:focus-visible) {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
  }
  .follows__toggles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  @media (max-width: 420px) {
    .corner,
    .toggle {
      padding: 0 0.75rem;
      font-size: 0.75rem;
      white-space: nowrap;
    }
  }
  .follows__code {
    max-width: 100%;
    margin: 0;
    padding: 1rem 1.2rem;
    border: 1px solid var(--rule);
    border-radius: 10px;
    overflow-x: auto;
    font: 0.8rem/1.5 var(--mono);
    color: var(--fg-2);
  }
  @media (max-width: 900px) {
    .follows__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
