---
import CopyChip from './CopyChip.astro'
const base = import.meta.env.BASE_URL
---

<section data-track="A1" id="top" class="hero" data-surface="a" data-stage-window tabindex="-1">
  <div class="hero__stage wrap">
    <div class="sleeve" data-sleeve>
      <div class="sleeve__top label">
        <span>PM—001</span>
        <span>LP · 2026</span>
      </div>
      <h1 class="display sleeve__title" aria-label="A music player that plays your page.">
        <span class="sleeve__line" aria-hidden="true">
          <span class="sleeve__ink">A music player</span>
        </span>
        <span class="sleeve__line" aria-hidden="true">
          <span class="sleeve__ink">
            that{' '}
            <span class="eq" data-eq>
              plays
            </span>
          </span>
        </span>
        <span class="sleeve__line" aria-hidden="true">
          <span class="sleeve__ink">your page.</span>
        </span>
      </h1>
      <div class="sleeve__foot">
        <p class="sleeve__lede">
          One Custom Element for every framework. It grows with its container, re-themes itself —
          and listens to the music it plays.
        </p>
        <p class="label sleeve__rpm">33⅓</p>
      </div>
    </div>

    <div class="record" data-record data-cursor="Drag to scratch · tap to play">
      <!-- The disc itself is drawn by the stage (scripts/stage); what follows
           is the flat record for browsers without WebGL2. -->
      <div class="record__fallback" aria-hidden="true"></div>
      <svg class="record__fx" viewBox="0 0 200 200" aria-hidden="true">
        <!-- The landing ripple travels through the vinyl only, never over the page. -->
        <clipPath id="record-disc">
          <circle cx="100" cy="100" r="89"></circle>
        </clipPath>
        <circle class="record__ring" cx="100" cy="100" r="0" clip-path="url(#record-disc)"></circle>
      </svg>
      <svg class="arm" viewBox="0 0 200 200" aria-hidden="true">
        <circle cx="170" cy="30" r="17" class="arm__base"></circle>
        <circle cx="170" cy="30" r="6" class="arm__pin"></circle>
        <g class="arm__swing">
          <path d="M170 30 L150 128 L112 160" class="arm__tube"></path>
          <rect
            x="98"
            y="152"
            width="22"
            height="14"
            rx="2"
            transform="rotate(-38 109 159)"
            class="arm__head"
          ></rect>
        </g>
      </svg>
    </div>
    <div class="console">
      <div class="console__player">
        <pulse-player data-mood-follow ambient-eq></pulse-player>
      </div>
      <div class="console__side">
        <div class="console__actions">
          <button class="btn" type="button" data-needle>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d="M8 5.5v13l10.5-6.5z"></path>
            </svg>
            <span data-needle-label>Drop the needle</span>
          </button>
          <a class="btn btn--ghost" href={`${base}playground/`}>
            Mixing desk
          </a>
        </div>
        <div class="console__chip">
          <CopyChip text="npm i @pulse-music/web-component" />
        </div>
      </div>
    </div>
  </div>

  <p class="hero__cue label" aria-hidden="true">
    <span>Side A</span>
    <span>Scroll</span>
  </p>
</section>

<script>
  import { engine } from '../scripts/audio'
  import { deck } from '../scripts/deck'
  import { eqSelfTest } from '../scripts/eq-word'
  import { $, onPage, reducedMotion } from '../scripts/lifecycle'
  import { gsap } from '../scripts/motion'
  import { setupNeedle } from '../scripts/needle'
  import '../scripts/stage/director'
  import '../scripts/record'
  import { intro as introShot } from '../scripts/stage/director'
  import { loaderLift } from '../scripts/loader'
  import { stage, stageLive, stageReady } from '../scripts/stage/stage'
  import { BEAT, EASE, EIGHTH, THIRTY_SECOND } from '../scripts/tempo'

  // Keep in sync with the compact layout media query in the styles below.
  const COMPACT =
    '(max-width: 760px), (max-width: 1100px) and (max-height: 520px) and (orientation: landscape)'

  onPage(() => {
    const hero = $('.hero')
    const btn = $('[data-needle]')
    const label = $('[data-needle-label]')
    if (!hero || !btn || !label) return
    const sync = (): void => {
      // While the platter runs down the music still plays, but the needle is
      // up; while the arm travels the needle is down, before the music starts.
      const down = (engine.state.isPlaying && !deck.braking) || deck.cueing
      label.textContent = down ? 'Lift the needle' : 'Drop the needle'
    }
    const onClick = (): void => {
      hero.dispatchEvent(new CustomEvent('needle:toggle'))
      // Say what the button will do next, now, not when the platter stops.
      label.textContent =
        label.textContent === 'Drop the needle' ? 'Lift the needle' : 'Drop the needle'
    }
    btn.addEventListener('click', onClick)
    const offState = engine.onStateChange(sync)
    sync()
    const offNeedle = setupNeedle(hero)

    // The opening, on side A's beat grid — a camera move, before anything
    // else: the page is first a room, the record a thing in it, and the
    // camera cranes up until the room is a page again.
    //   0            a low, close shot; the record turns in the paper room
    //   0 → 1½ beat  the camera orbits and cranes up to straight above
    //   1 beat       the tonearm swings in on a spring
    //   ~1 beat      the sleeve lands on the table (on phones: its card
    //                wipes in), a beat and a half later the title rises
    //   1½ beat      the console rises; the record slows and settles
    //   ~2 beats     the equaliser word sweeps once, like a meter waking up
    // Any input skips to the end. Without the stage (no WebGL2) the hero is
    // shown as it is.
    const html = document.documentElement
    const intro = html.classList.contains('intro')
    let skip: (() => void) | null = null
    const ctx = gsap.context(() => {
      if (!intro || reducedMotion() || !stageLive()) return
      const compact = matchMedia(COMPACT).matches
      const inks = gsap.utils.toArray<HTMLElement>('.sleeve__ink')
      const rise = ['.console__player', '.console__actions', '.console__chip', '.hero__cue']
      // Take over from the CSS starting state within the same frame: drop
      // the class first so GSAP reads clean transforms, then set its own.
      html.classList.remove('intro')
      gsap.set(inks, { yPercent: 112 })
      gsap.set(rise, { y: 24, opacity: 0 })
      if (compact) gsap.set('.hero__stage', { '--card-p': 0 })
      else gsap.set('.sleeve', { xPercent: -118 })
      gsap.set(stage.arm, { swing: -44, on: 1 })
      introShot.shot = (vw, vh) => {
        const m = Math.min(vw, vh)
        return compact
          ? { x: vw * 0.5, y: vh * 0.54, r: m * 0.46, az: -0.75, el: 0.36, dist: 3.1 }
          : { x: vw * 0.5, y: vh * 0.6, r: m * 0.4, az: -0.75, el: 0.34, dist: 3.2 }
      }
      introShot.k = 1
      introShot.drift = 0.9

      const tl = gsap.timeline({
        paused: true,
        defaults: { ease: EASE.out },
        onComplete: () => void (introShot.shot = null),
      })
      tl.to(introShot, { k: 0, duration: BEAT * 1.5, ease: EASE.inOut }, 0)
        .to(stage.arm, { swing: -24, duration: EIGHTH * 1.25, ease: EASE.gentle }, BEAT)
        .to(
          compact ? '.hero__stage' : '.sleeve',
          compact
            ? { '--card-p': 1, duration: BEAT * 0.75, ease: EASE.inOut }
            : { xPercent: 0, duration: BEAT * 0.75, ease: EASE.out },
          BEAT * 0.9,
        )
        .to(inks, { yPercent: 0, duration: EIGHTH * 1.5, stagger: THIRTY_SECOND }, BEAT * 1.3)
        .to(rise, { y: 0, opacity: 1, duration: EIGHTH, stagger: THIRTY_SECOND }, BEAT * 1.5)
        .to(introShot, { drift: 0, duration: BEAT, ease: EASE.out }, BEAT * 1.5)
        .add(() => eqSelfTest(hero), BEAT * 1.9)
      // Start with the labels on the disc (not waiting more than 1.2 s for
      // them) and, on a first visit, as the loading sleeve rises. Once it
      // runs, any input jumps to the end.
      const events = ['wheel', 'touchstart', 'keydown', 'pointerdown'] as const
      const skipNow = (): void => {
        tl.progress(1)
        skip?.()
      }
      skip = () => {
        events.forEach((e) => removeEventListener(e, skipNow, true))
        skip = null
      }
      void Promise.all([
        Promise.race([stageReady(), new Promise((r) => setTimeout(r, 1200))]),
        loaderLift,
      ]).then(() => {
        if (!skip) return // the page was left meanwhile
        tl.play()
        events.forEach((e) => addEventListener(e, skipNow, { capture: true, passive: true }))
      })
    }, hero)
    // Nothing to open (no stage, reduced motion, a return visit): as it is.
    html.classList.remove('intro')
    return () => {
      btn.removeEventListener('click', onClick)
      offState()
      offNeedle()
      skip?.()
      introShot.k = 0
      introShot.drift = 0
      introShot.shot = null
      ctx.kill() // swapped out: stop, don't restore
    }
  })
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: max(100svh, 640px);
    padding-top: calc(var(--header) + 1rem);
    padding-bottom: 3.5rem;
    overflow: clip;
    outline: none;
  }
  /* Sleeve | record sliding out of it | the console you play it with. */
  .hero__stage {
    --page: min(1720px, 100%);
    --size: min(64svh, 36vw, 640px);
    position: relative;
    display: grid;
    grid-template-columns: var(--size) calc(var(--size) * 0.66) minmax(0, 1fr);
    column-gap: var(--gutter);
    align-items: center;
  }

  /* ─── Sleeve ─────────────────────────────────────────────────── */
  .sleeve {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-rows: auto 1fr auto;
    width: var(--size);
    aspect-ratio: 1;
    padding: clamp(1rem, 2.2vw, 1.75rem);
    background: #e4ddcf;
    box-shadow:
      0 0 0 1px rgb(19 18 16 / 0.2),
      0 40px 80px -40px rgb(19 18 16 / 0.45),
      inset 0 0 0 10px #e4ddcf,
      inset 0 0 0 11px rgb(19 18 16 / 0.18);
  }
  .sleeve__top,
  .sleeve__foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
  }
  .sleeve__title {
    align-self: center;
    font-size: calc(var(--size) * 0.132);
  }
  .sleeve__line {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    padding-bottom: 0.04em;
  }
  .sleeve__ink {
    display: block;
  }
  /* The equaliser word: at rest, full height and fully orange. */
  .eq {
    display: inline-block;
  }
  .eq :global(.eq__l) {
    --fill: 100%;
    display: inline-block;
    transform-origin: 50% 88%;
    color: transparent;
    background-image: linear-gradient(
      to top,
      var(--signal-large) var(--fill),
      var(--ink) var(--fill)
    );
    -webkit-background-clip: text;
    background-clip: text;
  }
  /* Starting state before the opening takes over (hard loads only): an
     empty table — the sleeve not yet on it, the words not yet written. */
  :global(html.intro) .sleeve__ink {
    transform: translateY(112%);
  }
  :global(html.intro) .sleeve {
    transform: translateX(-118%);
  }
  :global(html.intro) .console__player,
  :global(html.intro) .console__actions,
  :global(html.intro) .console__chip,
  :global(html.intro) .hero__cue {
    opacity: 0;
  }
  .sleeve__lede {
    max-width: 30ch;
    font-size: clamp(0.8rem, 0.6rem + 0.45vw, 1rem);
    line-height: 1.35;
    color: var(--fg-2);
  }
  .sleeve__rpm {
    font-size: 1.1rem;
  }

  /* ─── Record ─────────────────────────────────────────────────── */
  .record {
    position: relative;
    z-index: 1;
    width: calc(var(--size) * 1.02);
    aspect-ratio: 1;
    margin-left: calc(var(--size) * -0.36 - var(--gutter));
    touch-action: none;
    cursor: grab;
  }
  .record.is-scratching {
    cursor: grabbing;
  }
  /* Phones and tablets: a swipe that starts on the record still scrolls the
     page; horizontal drags keep scratching. */
  @media (pointer: coarse) {
    .record {
      touch-action: pan-y;
    }
  }
  .record__fallback {
    position: absolute;
    inset: 5%;
    display: none;
    border-radius: 50%;
    background:
      radial-gradient(
        circle,
        #131210 0 3%,
        var(--signal) 3.5% 33%,
        #151311 33.5% 36%,
        transparent 36%
      ),
      repeating-radial-gradient(circle, #181614 0 1px, #0f0e0d 1px 3px);
    box-shadow: 0 30px 60px -30px rgb(19 18 16 / 0.6);
  }
  .record.is-fallback .record__fallback {
    display: block;
  }
  /* With the stage live, the arm and the ripple are part of the scene. */
  :global(html.staged) .arm,
  :global(html.staged) .record__fx {
    display: none;
  }
  .arm {
    position: absolute;
    top: -2%;
    right: -6%;
    width: 42%;
    pointer-events: none;
    overflow: visible;
  }
  .arm__base {
    fill: #d9d2c4;
    stroke: rgb(19 18 16 / 0.35);
  }
  .arm__pin {
    fill: var(--ink);
  }
  .arm__tube {
    fill: none;
    stroke: var(--ink);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .arm__head {
    fill: var(--ink);
  }
  .record__fx {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .record__ring {
    fill: none;
    stroke: var(--signal);
    stroke-width: 2;
    opacity: 0;
  }

  /* ─── Console ────────────────────────────────────────────────── */
  .console {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    align-content: center;
    max-width: 520px;
  }
  .console__player pulse-player {
    --pulse-shadow: 0 24px 50px -28px rgb(19 18 16 / 0.6);
  }
  .console__side {
    display: grid;
    grid-template-columns: minmax(0, auto);
    gap: 1rem;
    justify-items: start;
    min-width: 0;
  }
  .console__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .hero__cue {
    position: absolute;
    left: var(--gutter);
    bottom: 1rem;
    display: flex;
    gap: 2.5rem;
    color: var(--fg-3);
  }

  @media (max-width: 1100px) {
    .hero__stage {
      --size: min(60svh, 50vw, 560px);
      grid-template-columns: var(--size) minmax(0, 1fr);
    }
    .record {
      width: calc(var(--size) * 0.96);
    }
    .console {
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      align-items: center;
      max-width: none;
      margin-top: 2rem;
    }
  }
  /* ─── Compact: phones (portrait) and short landscape screens ─────
     The sleeve becomes a card that carries the call to action, and the
     record slides out from under its bottom edge. The card itself is drawn
     by ::before so it can span the title and the buttons. */
  @media (max-width: 760px),
    (max-width: 1100px) and (max-height: 520px) and (orientation: landscape) {
    .hero {
      align-items: start;
      min-height: 0;
      padding-bottom: 4.5rem;
    }
    .hero__stage {
      --pad: clamp(1rem, 4.5vw, 1.5rem);
      --disc: min(88vw, 440px);
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      column-gap: var(--gutter);
      align-items: start;
      justify-items: stretch;
    }
    .hero__stage::before {
      content: '';
      z-index: 2;
      align-self: stretch;
      grid-row: 1 / 3;
      grid-column: 1;
      /* The opening wipes the card in from its left edge. */
      clip-path: inset(-60px calc((1 - var(--card-p, 1)) * (100% + 120px) - 60px) -60px -60px);
      background: #e4ddcf;
      box-shadow:
        0 0 0 1px rgb(19 18 16 / 0.2),
        0 40px 80px -40px rgb(19 18 16 / 0.45),
        inset 0 0 0 8px #e4ddcf,
        inset 0 0 0 9px rgb(19 18 16 / 0.18);
    }
    .sleeve {
      z-index: 3;
      grid-row: 1;
      grid-column: 1;
      width: auto;
      aspect-ratio: auto;
      gap: 1.25rem;
      padding: var(--pad) var(--pad) 1.25rem;
      background: none;
      box-shadow: none;
      /* Its words arrive with its card. */
      clip-path: inset(-60px calc((1 - var(--card-p, 1)) * (100% + 120px) - 60px) -60px -60px);
    }
    .sleeve__title {
      font-size: clamp(2.1rem, 11.2vw, 3.6rem);
      margin-block: 0.75rem 0.25rem;
    }
    .sleeve__lede {
      font-size: 0.9rem;
    }
    .console,
    .console__side {
      display: contents;
    }
    .console__actions {
      z-index: 3;
      grid-row: 2;
      grid-column: 1;
      padding: 0 var(--pad) var(--pad);
    }
    .record {
      grid-row: 3;
      grid-column: 1;
      justify-self: center;
      width: var(--disc);
      margin: calc(var(--disc) * -0.3) 0 0;
    }
    .arm {
      display: none;
    }
    :global(html.intro) .sleeve {
      transform: none;
    }
    :global(html.intro) .hero__stage {
      --card-p: 0;
    }
    .console__player {
      z-index: 3;
      grid-row: 4;
      grid-column: 1 / -1;
      margin-top: 1.25rem;
    }
    .console__chip {
      z-index: 3;
      grid-row: 5;
      grid-column: 1 / -1;
      margin-top: 1rem;
    }
  }
  /* Landscape phones: card on the left, record beside it. */
  @media (max-width: 1100px) and (max-height: 520px) and (orientation: landscape) {
    .hero__stage {
      --disc: min(62svh, 40vw);
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .sleeve {
      gap: 0.5rem;
    }
    .sleeve__title {
      font-size: clamp(1.9rem, 10svh, 3rem);
      margin-block: 0.25rem 0;
    }
    /* Too short for the paragraph: it is repeated right below the hero. */
    .sleeve__lede {
      display: none;
    }
    .sleeve__rpm {
      margin-left: auto;
    }
    .record {
      grid-row: 1 / 3;
      grid-column: 2;
      align-self: center;
      margin: 0 0 0 calc(var(--disc) * -0.22);
    }
  }
</style>
