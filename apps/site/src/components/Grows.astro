---
const tiers = [
  { at: 460, name: 'Full', drops: 'Everything, mute included' },
  { at: 360, name: 'Wide', drops: 'Mute folds away' },
  { at: 280, name: 'Medium', drops: 'Time and actions fold' },
  { at: 210, name: 'Narrow', drops: 'Skip buttons fold' },
  { at: 128, name: 'Compact', drops: 'Just cover, title, play' },
  { at: 0, name: 'Disc', drops: 'A spinning record' },
]
const MAX = 760
---

<section id="grows" class="grows" data-surface="a" aria-labelledby="grows-title" data-grows>
  <div class="grows__sticky">
    <div class="wrap grows__inner">
      <div class="track-head">
        <span class="label">A2</span>
        <span class="label">Grows with the page</span>
        <span class="label">1:10</span>
      </div>

      <div class="grows__top">
        <h2 id="grows-title" class="headline" data-split>
          No breakpoints.
          <br />
          It reads its own&nbsp;width.
        </h2>
        <div class="grows__readout" aria-hidden="true">
          <span class="grows__px">
            <span data-grows-px>760</span>
            <small>px</small>
          </span>
          <span class="grows__tier serif" data-grows-tier>
            Full
          </span>
        </div>
      </div>

      <div class="grows__bench">
        <div class="grows__frame" data-grows-frame>
          <pulse-player data-mood-follow></pulse-player>
        </div>
      </div>

      <div class="ruler" aria-hidden="true">
        <div class="ruler__track">
          {tiers.slice(0, -1).map((t) => (
            <span class="ruler__tick" style={`--x:${t.at / MAX}`}>
              <b>{t.at}</b>
            </span>
          ))}
          <span class="ruler__cursor" data-grows-cursor></span>
        </div>
      </div>

      <div class="grows__foot">
        <label class="grows__slider">
          <span class="label">Width</span>
          <input
            type="range"
            min="96"
            max={MAX}
            value={MAX}
            step="1"
            data-grows-range
            aria-valuetext="760 pixels, Full"
          />
        </label>
        <p class="grows__drops" data-grows-drops aria-live="polite">
          {tiers[0].drops}
        </p>
        <code class="grows__code">@container pulse (width &lt; 128px)</code>
      </div>
    </div>
  </div>
</section>

<script>
  import { $, onPage, reducedMotion } from '../scripts/lifecycle'
  import { gsap, ScrollTrigger } from '../scripts/motion'

  // Keep in sync with the pinned-scene media query in the styles below.
  const PINNED = '(min-height: 561px) and (prefers-reduced-motion: no-preference)'

  const TIERS: [number, string, string][] = [
    [460, 'Full', 'Everything, mute included'],
    [360, 'Wide', 'Mute folds away'],
    [280, 'Medium', 'Time and actions fold'],
    [210, 'Narrow', 'Skip buttons fold'],
    [128, 'Compact', 'Just cover, title, play'],
    [0, 'Disc', 'A spinning record'],
  ]
  const MIN = 96
  const MAX = 760

  onPage(() => {
    const section = $('[data-grows]')
    const frame = $('[data-grows-frame]')
    const range = $<HTMLInputElement>('[data-grows-range]')
    const px = $('[data-grows-px]')
    const tier = $('[data-grows-tier]')
    const drops = $('[data-grows-drops]')
    const cursor = $('[data-grows-cursor]')
    if (!section || !frame || !range || !px || !tier || !drops || !cursor) return

    let lastTier = ''
    const set = (width: number): void => {
      const room = frame.parentElement?.clientWidth ?? MAX
      const w = Math.round(Math.min(width, room))
      frame.style.width = `${w}px`
      px.textContent = String(w)
      cursor.style.setProperty('--x', String(w / MAX))
      const [, name, text] = TIERS.find(([at]) => w >= at) ?? TIERS[TIERS.length - 1]
      range.setAttribute('aria-valuetext', `${w} pixels, ${name}`)
      if (name !== lastTier) {
        lastTier = name
        tier.textContent = name
        drops.textContent = text
        tier.animate?.(
          [
            { opacity: 0, transform: 'translateY(40%)' },
            { opacity: 1, transform: 'none' },
          ],
          { duration: reducedMotion() ? 0 : 420, easing: 'cubic-bezier(.16,1,.3,1)' },
        )
      }
    }

    const onInput = (): void => set(Number(range.value))
    range.addEventListener('input', onInput)
    set(MAX)

    // One scene on the whole site is scrubbed by scroll: this one. It needs
    // room to breathe, so short screens (landscape phones) keep the slider.
    const mm = gsap.matchMedia()
    mm.add(PINNED, () => {
      const trigger = ScrollTrigger.create({
        trigger: section,
        start: 'top top',
        end: 'bottom bottom',
        scrub: true,
        onUpdate(self) {
          const p = Math.min(1, Math.max(0, (self.progress - 0.1) / 0.78))
          const eased = p * p * (3 - 2 * p)
          const width = MAX - eased * (MAX - MIN)
          range.value = String(Math.round(width))
          set(width)
        },
      })
      return () => trigger.kill()
    })
    return () => {
      range.removeEventListener('input', onInput)
      mm.revert()
    }
  })
</script>

<style>
  .grows {
    position: relative;
  }
  .grows__sticky {
    padding-block: clamp(3rem, 8vh, 6rem);
  }
  @media (min-height: 561px) {
    :global(html.js:not(.reduced)) .grows {
      height: 320svh;
    }
    :global(html.js:not(.reduced)) .grows__sticky {
      position: sticky;
      top: 0;
      display: flex;
      align-items: center;
      min-height: 100svh;
      padding-block: calc(var(--header) + 1rem) 2rem;
    }
  }
  .grows__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.25rem, 3.5vh, 2.5rem);
    width: 100%;
  }
  .grows__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .grows__top h2 {
    max-width: 14ch;
  }
  .grows__readout {
    display: grid;
    justify-items: end;
    line-height: 0.8;
  }
  .grows__px {
    font-family: var(--display);
    font-weight: 820;
    font-variation-settings: 'wdth' 62;
    font-size: clamp(5rem, 2rem + 11vw, 13rem);
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .grows__px small {
    margin-left: 0.08em;
    font-size: 0.24em;
    font-family: var(--mono);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--fg-3);
  }
  .grows__tier {
    display: inline-block;
    font-size: clamp(1.6rem, 1rem + 2vw, 2.8rem);
    color: var(--signal-ink);
  }
  .grows__bench {
    display: flex;
    align-items: center;
    min-height: 150px;
  }
  .grows__bench > * {
    min-width: 0;
  }
  .grows__frame {
    width: 760px;
    max-width: 100%;
  }
  .ruler__track {
    position: relative;
    max-width: 760px;
    height: 34px;
    border-top: 1px solid var(--fg);
    background: repeating-linear-gradient(90deg, var(--rule) 0 1px, transparent 1px calc(100% / 38))
      top / 100% 8px no-repeat;
  }
  .ruler__tick {
    position: absolute;
    top: 0;
    left: calc(var(--x) * 100%);
    height: 14px;
    border-left: 1px solid var(--fg);
  }
  .ruler__tick b {
    position: absolute;
    top: 16px;
    left: 0;
    translate: -50% 0;
    font: 400 0.75rem/1 var(--mono);
    color: var(--fg-2);
  }
  .ruler__cursor {
    position: absolute;
    top: -7px;
    left: calc(var(--x, 1) * 100%);
    width: 13px;
    height: 13px;
    translate: -50% 0;
    rotate: 45deg;
    background: var(--signal);
  }
  .grows__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }
  .grows__slider {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .grows__slider input {
    width: min(240px, 50vw);
    height: 32px;
    accent-color: var(--signal-ink);
  }
  .grows__drops {
    min-width: 16ch;
    color: var(--fg-2);
  }
  .grows__code {
    margin-left: auto;
    font: 0.78rem var(--mono);
    color: var(--fg-3);
  }
  @media (max-width: 640px) {
    .grows__code {
      margin-left: 0;
    }
    .grows__readout {
      justify-items: start;
    }
  }
</style>
