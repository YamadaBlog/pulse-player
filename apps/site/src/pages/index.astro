---
import Base from '../layouts/Base.astro'
import Hero from '../components/Hero.astro'
import Tour from '../components/Tour.astro'
import Grows from '../components/Grows.astro'
import Moods from '../components/Moods.astro'
import Flip from '../components/Flip.astro'
import Follows from '../components/Follows.astro'
import Listens from '../components/Listens.astro'
import Dialects from '../components/Dialects.astro'
import Heard from '../components/Heard.astro'
import Pressed from '../components/Pressed.astro'
import Reel from '../components/Reel.astro'
import LinerNotes from '../components/LinerNotes.astro'
---

<Base
  title="Pulse · A music player that plays your page"
  description="One Custom Element music player for every framework. It grows with its container, wears nine moods, follows you across the page and listens to the music it plays."
>
  <div class="stage" data-stage aria-hidden="true">
    <canvas></canvas>
  </div>
  <Hero />
  <Tour />
  <Grows />
  <Moods />
  <Flip />
  <Follows />
  <Listens />
  <Dialects />
  <Heard />
  <Reel />
  <Pressed />
  <LinerNotes />
</Base>
