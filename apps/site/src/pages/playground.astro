---
import Base from '../layouts/Base.astro'
import Desk from '../components/Desk.vue'
import LinerNotes from '../components/LinerNotes.astro'
---

<Base
  title="Mixing desk · Pulse"
  description="Tune the Pulse player — mood, accent, width and options — and copy the code for HTML, Vue, React, Svelte or Angular."
  side="b"
>
  <section data-track="C3" id="top" class="side-b desk-page" data-surface="b" tabindex="-1">
    <div class="wrap">
      <div class="desk-page__head">
        <p class="label">C3 · The mixing desk</p>
        <h1 class="display desk-page__title" data-split>
          Mix it.
          <br />
          Then take the code.
        </h1>
        <p class="lede">
          Every fader here is a plain attribute. Whatever you dial in is what you copy — for the
          framework you actually use.
        </p>
      </div>
      <Desk client:load />
    </div>
  </section>
  <LinerNotes />
</Base>

<style>
  .desk-page {
    min-height: 100svh;
    padding-block: calc(var(--header) + clamp(2rem, 6vw, 5rem)) clamp(4rem, 8vw, 7rem);
  }
  .desk-page__head {
    display: grid;
    gap: 1.4rem;
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }
  .desk-page__title {
    font-size: clamp(3rem, 1rem + 8vw, 9rem);
  }
</style>
