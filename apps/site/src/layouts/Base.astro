---
import { ClientRouter } from 'astro:transitions'
import SiteHeader from '../components/SiteHeader.astro'
import Tracklist from '../components/Tracklist.astro'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  side?: 'a' | 'b'
}

const { title, description, side = 'a' } = Astro.props
const base = import.meta.env.BASE_URL
const canonical = new URL(Astro.url.pathname, Astro.site)
const og = new URL(`${base}og-banner.png`, Astro.site)
---

<!doctype html>
<html lang="en" data-side={side}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ece7dc" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pulse" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareSourceCode',
        name: 'Pulse',
        description,
        codeRepository: 'https://github.com/YamadaBlog/pulse-player',
        programmingLanguage: 'TypeScript',
        license: 'https://opensource.org/licenses/MIT',
        author: {
          '@type': 'Person',
          name: 'Loïc',
          alternateName: 'YamadaBlog',
          url: 'https://github.com/YamadaBlog',
        },
      })}
    />
    <script is:inline>
      document.documentElement.classList.add('js')
      if (matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.documentElement.classList.add('reduced')
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Tracklist />

    <!-- The mini player lives outside the swapped content: music never stops between pages. -->
    <pulse-fab transition:persist="fab" pulso data-mood-follow></pulse-fab>
    <div class="cursor-tag" aria-hidden="true" transition:persist="cursor">
      <span></span>
    </div>

    <script>
      import '@pulse-music/web-component'
      import '../scripts/audio'
      import '../scripts/motion'
      import '../scripts/chrome'
      import '../scripts/breathe'
    </script>
  </body>
</html>

<style is:global>
  .skip {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 200;
    padding: 12px 18px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--mono);
    font-size: 0.8rem;
    text-decoration: none;
    transform: translateY(-160%);
    transition: transform 0.4s var(--ease-out);
  }
  .skip:focus-visible {
    transform: none;
  }
  main:focus {
    outline: none;
  }
  html.js:not(.reduced) [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
  }
  [data-reveal] {
    opacity: 1;
    transform: none;
  }
  pulse-fab {
    --pulse-fab-z: 60;
  }
  .cursor-tag {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 150;
    pointer-events: none;
    display: none;
  }
  .cursor-tag span {
    display: block;
    padding: 7px 12px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    transform: translate(18px, 18px) scale(0.6);
    opacity: 0;
    transition:
      opacity 0.25s var(--ease-out),
      transform 0.45s var(--ease-out);
  }
  .cursor-tag[data-on] span {
    opacity: 1;
    transform: translate(18px, 18px) scale(1);
  }
  @media (pointer: fine) {
    .cursor-tag {
      display: block;
    }
  }
</style>
