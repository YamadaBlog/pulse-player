---
import { ClientRouter } from 'astro:transitions'
import SiteHeader from '../components/SiteHeader.astro'
import Tracklist from '../components/Tracklist.astro'
import { createMotionCss } from '@pulse-music/tokens'
import archivo from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url'
import geistMono from '../assets/fonts/GeistMono-Variable.woff2?url'
import Loader from '../components/Loader.astro'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  side?: 'a' | 'b'
  /** Show the loading sleeve on the first load of a visit (the home page). */
  loader?: boolean
}

const { title, description, side = 'a', loader = false } = Astro.props
const base = import.meta.env.BASE_URL
const canonical = new URL(Astro.url.pathname, Astro.site)
const og = new URL(`${base}og-banner.png`, Astro.site)
---

<!doctype html>
<html lang="en" data-side={side}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ece7dc" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMono} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pulse" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareSourceCode',
        name: 'Pulse',
        description,
        codeRepository: 'https://github.com/YamadaBlog/pulse-player',
        programmingLanguage: 'TypeScript',
        license: 'https://opensource.org/licenses/MIT',
        author: {
          '@type': 'Person',
          name: 'Mao',
          alternateName: 'YamadaBlog',
          url: 'https://github.com/YamadaBlog',
        },
      })}
    />
    <script is:inline data-loader-page={loader ? '1' : undefined}>
      document.documentElement.classList.add('js')
      if (matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.documentElement.classList.add('reduced')
      else {
        // The hero's opening starts from a state set before the first paint.
        // If its script never runs, show everything anyway.
        document.documentElement.classList.add('intro')
        setTimeout(() => document.documentElement.classList.remove('intro'), 2500)
        // The first load of a visit starts behind the loading sleeve
        // (Loader.astro); never for longer than 9 s, even without scripts.
        let seen = false
        try {
          seen = !!sessionStorage.getItem('pulse-loaded')
        } catch {
          /* storage unavailable: show the sleeve */
        }
        if (document.currentScript?.dataset.loaderPage && !seen) {
          document.documentElement.classList.add('loading')
          setTimeout(() => document.documentElement.classList.remove('loading'), 9000)
        }
      }
      // Entrances start hidden. If the scripts haven't booted after 3 s, the
      // page is shown as it is, statically — nothing may stay invisible.
      setTimeout(() => {
        const html = document.documentElement
        if (!html.classList.contains('booted')) html.classList.add('static')
      }, 3000)
    </script>
    <style is:inline set:html={createMotionCss(':root')}></style>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    {loader && <Loader />}
    <a class="skip" href="#main">
      Skip to content
    </a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Tracklist />

    <!-- The mini player lives outside the swapped content: music never stops between pages. -->
    <pulse-fab transition:persist="fab" pulso data-mood-follow></pulse-fab>
    <div class="cursor-tag" aria-hidden="true" transition:persist="cursor">
      <span></span>
    </div>

    <script>
      import '@pulse-music/web-component'
      import '../scripts/audio'
      import '../scripts/motion'
      import '../scripts/chrome'
      import '../scripts/breathe'
    </script>
  </body>
</html>

<style is:global>
  .skip {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 200;
    padding: 12px 18px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--mono);
    font-size: 0.8rem;
    text-decoration: none;
    transform: translateY(-160%);
    transition: transform var(--beat-2) var(--ease-out);
  }
  .skip:focus-visible {
    transform: none;
  }
  main:focus {
    outline: none;
  }
  html.js:not(.reduced):not(.static) [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
  }
  [data-reveal] {
    opacity: 1;
    transform: none;
  }
  pulse-fab {
    --pulse-fab-z: 60;
  }
  .cursor-tag {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 150;
    pointer-events: none;
    display: none;
  }
  .cursor-tag span {
    display: block;
    padding: 7px 12px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    transform: translate(18px, 18px) scale(0.6);
    opacity: 0;
    transition:
      opacity var(--beat-4) var(--ease-out),
      transform var(--beat-2) var(--ease-out);
  }
  .cursor-tag[data-on] span {
    opacity: 1;
    transform: translate(18px, 18px) scale(1);
  }
  @media (pointer: fine) {
    .cursor-tag {
      display: block;
    }
  }
</style>
